#!/bin/sh
# /etc/kernel/postinst.d hook: flash the freshly generated initramfs to the
# GPT initrd partition with the BootApp 4-byte LE size prefix.  Named zz-* so
# it sorts after initramfs-tools, which regenerates initrd.img-$1 first.
# A failure here fails the kernel postinst, which the deploy bootstrap
# treats as "do not reboot".
set -e

version="${1:-}"
bootsrc="${2:-/boot}"
img="$bootsrc/initrd.img-$version"
# some rootfs images run mkinitramfs with an empty BOOTDIR and drop the
# image at the filesystem root instead of /boot
[ -f "$img" ] || img="/initrd.img-$version"
[ -n "$version" ] && [ -f "$img" ] || exit 0

part_dev() {
    for u in /sys/class/block/*/uevent; do
        grep -q "^PARTNAME=$1\$" "$u" 2>/dev/null || continue
        d="$(sed -n 's/^DEVNAME=//p' "$u")"
        [ -n "$d" ] && { echo "/dev/$d"; return 0; }
    done
    return 1
}

dev="$(part_dev initrd)" || { echo "iceland: GPT partition 'initrd' not found" >&2; exit 1; }
size="$(stat -c %s "$img")"
# an initramfs without the curated module set cannot boot this device;
# MODULES=list plus the iceland hook lands around 40-60MB -- well above
# this floor (an 11MB image means the module set never made it in)
[ "$size" -ge $((15 * 1024 * 1024)) ] || {
    echo "iceland: initrd.img-$version is only $size bytes -- module set missing, refusing to flash" >&2
    exit 1
}
b0=$((size & 255)); b1=$(((size >> 8) & 255))
b2=$(((size >> 16) & 255)); b3=$(((size >> 24) & 255))
hdr="$(printf '\\%03o\\%03o\\%03o\\%03o' "$b0" "$b1" "$b2" "$b3")"
if ! { printf '%b' "$hdr"; cat "$img"; } | dd of="$dev" bs=1M conv=fsync 2>/dev/null; then
    echo "iceland: flashing the initrd partition failed" >&2
    exit 1
fi
echo "iceland: initrd.img-$version flashed to partition 'initrd' ($size bytes)"
exit 0
