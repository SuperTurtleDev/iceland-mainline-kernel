#!/bin/sh
# linux-tools-@KVER@ prerm: drop the symlinks postinst created; the
# unversioned name only when it is ours.
set -e
KVER="@KVER@"

case "$1" in
remove|upgrade|deconfigure)
    if [ "$(readlink /usr/bin/perf 2>/dev/null)" = "perf-${KVER}" ]; then
        rm -f /usr/bin/perf
    fi
    rm -f "/usr/bin/perf-${KVER}"
    ;;
esac
exit 0
