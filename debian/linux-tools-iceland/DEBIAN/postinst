#!/bin/sh
# linux-tools-@KVER@ postinst: version-specific command names.
# The symlinks are maintained here rather than shipped so that this package
# never owns /usr/bin/perf and cannot conflict with Ubuntu's linux-perf.
set -e
KVER="@KVER@"
LIB="/usr/lib/linux-tools-${KVER}"

case "$1" in
configure)
    ln -sfn "${LIB}/perf" "/usr/bin/perf-${KVER}"
    # unversioned name only if nothing is there (a dangling link counts as
    # nothing: -e follows symlinks)
    if [ ! -e /usr/bin/perf ]; then
        ln -sfn "perf-${KVER}" /usr/bin/perf
    fi
    ;;
esac
exit 0
