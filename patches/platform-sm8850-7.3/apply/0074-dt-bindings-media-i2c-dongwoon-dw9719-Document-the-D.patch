From 95b1525a4daf817c44ce3f310c7446254eb2e819 Mon Sep 17 00:00:00 2001
From: Yibo Wang <wyibo6109@gmail.com>
Date: Fri, 16 Oct 2026 02:35:10 -0500
Subject: [PATCH 74/79] dt-bindings: media: i2c: dongwoon,dw9719: Document the
 DW9714V

The Dongwoon DW9714V is a DW9714 successor with a second, register
mapped ("advanced") operating mode. In that mode it exposes the DW9719
register layout (INFO, CONTROL, VCM MSB/LSB, STATUS, VCM_FREQ) plus a
SAC configuration register of its own, so it is served by the dw9719
driver.

Add the compatible and the one DW9714V specific knob, the ringing
control enable (SAC_CFG RING_EN). The SAC mode reuses the family
encoding restricted to the SAC2/SAC3/SAC4 modes the part implements,
and dongwoon,vcm-prescale carries the raw VCM_FREQ value as it does for
the DW9800K, with the layout spelled out: the datasheet's two-bit
prescaler at 0x07 does not describe the silicon, which uses bits 7:6 as
the period divider and bits 5:0 as the period.

Also list the binding in the DW9719 MAINTAINERS entry.

Signed-off-by: Yibo Wang <2024312277@stu.hit.edu.cn>
Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
(cherry picked from commit 14458640b1d946416d6abfa9309363177928eeda)
---
 .../bindings/media/i2c/dongwoon,dw9719.yaml   | 61 +++++++++++++++++--
 MAINTAINERS                                   |  1 +
 2 files changed, 56 insertions(+), 6 deletions(-)

diff --git a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml
index c159e3210cef63e94078972ca6ff8c44e7a28ef1..5ad75d745464cda2f58c8bd52c6fe4c0cd09d9f4 100644
--- a/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml
+++ b/Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml
@@ -10,12 +10,14 @@ maintainers:
   - André Apitzsch <git@apitzsch.eu>
 
 description:
-  The Dongwoon DW9718S/9719/9761 is a single 10-bit digital-to-analog converter
-  with 100 mA output current sink capability, designed for linear control of
-  voice coil motors (VCM) in camera lenses. This chip provides a Smart Actuator
-  Control (SAC) mode intended for driving voice coil lenses in camera modules.
-  The DW9714V exposes the same register layout in its register-mapped
-  ("advanced") mode.
+  The Dongwoon DW9718S/9719/9761/9800K are single 10-bit digital-to-analog
+  converters with 100 mA output current sink capability, designed for linear
+  control of voice coil motors (VCM) in camera lenses. These chips provide a
+  Smart Actuator Control (SAC) mode intended for driving voice coil lenses
+  in camera modules. The DW9714V is a DW9714 successor which additionally
+  provides a register-mapped ("advanced") mode with the DW9719 register
+  layout and SAC2/SAC3/SAC4 ringing control, entered by an I2C command
+  sequence.
 
 properties:
   compatible:
@@ -53,6 +55,13 @@ properties:
       Indication of VCM switching frequency dividing rate select.
     $ref: /schemas/types.yaml#/definitions/uint32
 
+  dongwoon,sac-ring-enable:
+    description:
+      Enable the ringing control block (SAC_CFG RING_EN). When absent, the
+      DAC is driven directly (DW9714-compatible behavior) and
+      dongwoon,sac-mode has no effect.
+    type: boolean
+
 required:
   - compatible
   - reg
@@ -72,6 +81,29 @@ allOf:
           maximum: 15
           default: 0
 
+  - if:
+      properties:
+        compatible:
+          contains:
+            const: dongwoon,dw9714v
+    then:
+      properties:
+        dongwoon,sac-mode:
+          description:
+            SAC2, SAC3 or SAC4 ringing control mode.
+          enum: [3, 4, 5]
+        dongwoon,vcm-prescale:
+          description:
+            Value of the VCM_FREQ register. Bits 7:6 select the ringing
+            control period divider (2, 1, 1/2, 1/4), bits 5:0 the period,
+            which has to match the mechanical vibration period (tVIB) of
+            the actuator and lens assembly of the camera module.
+          maximum: 255
+          default: 0x60
+    else:
+      properties:
+        dongwoon,sac-ring-enable: false
+
 additionalProperties: false
 
 examples:
@@ -90,3 +122,20 @@ examples:
             dongwoon,vcm-prescale = <0>;
         };
     };
+
+  - |
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        actuator@c {
+            compatible = "dongwoon,dw9714v";
+            reg = <0x0c>;
+
+            vdd-supply = <&vreg_l16b_2p8>;
+
+            dongwoon,sac-ring-enable;
+            dongwoon,sac-mode = <3>;
+            dongwoon,vcm-prescale = <0x79>;
+        };
+    };
diff --git a/MAINTAINERS b/MAINTAINERS
index 60aeebec140d76f7bad8461e07b9d6afd767842d..29c0be9b6eaabc89d1d9d13a4921062074261300 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -7865,6 +7865,7 @@ M:	Daniel Scally <dan.scally@ideasonboard.com>
 L:	linux-media@vger.kernel.org
 S:	Maintained
 T:	git git://linuxtv.org/media.git
+F:	Documentation/devicetree/bindings/media/i2c/dongwoon,dw9719.yaml
 F:	drivers/media/i2c/dw9719.c
 
 DONGWOON DW9768 LENS VOICE COIL DRIVER
