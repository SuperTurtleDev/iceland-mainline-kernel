 static int novatek_probe(struct mipi_dsi_device *dsi)
 {
 	struct mipi_dsi_device_info dsi_info = {"dsi-secondary", 0, NULL};
@@ -466,8 +693,26 @@ static const struct panel_desc csot_pp8807hb1_1_desc = {
