+	 * CSIPHY core 0.88 V and PLL 1.2 V rails, per the vendor DT:
+	 * L1D feeds every PLL, L3I the cores of PHY 0/1/3/5, L3D PHY 2/4.
+	 */
+	vdd-csiphy0-0p8-supply = <&vreg_l3i_0p8>;
+	vdd-csiphy0-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy1-0p8-supply = <&vreg_l3i_0p8>;
+	vdd-csiphy1-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy2-0p8-supply = <&vreg_l3d_0p8>;
+	vdd-csiphy2-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy3-0p8-supply = <&vreg_l3i_0p8>;
+	vdd-csiphy3-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy4-0p8-supply = <&vreg_l3d_0p8>;
+	vdd-csiphy4-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy5-0p8-supply = <&vreg_l3i_0p8>;
+	vdd-csiphy5-1p2-supply = <&vreg_l1d_1p2>;
+
+	status = "okay";
+
+	ports {
+		/* rear sensor, 4 D-PHY data lanes */
+		port@4 {
+			csiphy4_ep: endpoint {
+				clock-lanes = <4>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&cam_rear_ep>;
+			};
+		};
+
+		/* front sensor, 4 D-PHY data lanes */
+		port@5 {
+			csiphy5_ep: endpoint {
+				clock-lanes = <4>;
+				data-lanes = <0 1 2 3>;
+				remote-endpoint = <&cam_front_ep>;
+			};
+		};
+	};
+};
+
+&gpu_zap_shader {
