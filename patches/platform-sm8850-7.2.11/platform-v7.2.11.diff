+/*******************************************************
+Description:
+	Novatek touchscreen reset MCU (boot) function.
+
+return:
+	n.a.
+*******************************************************/
+void nvt_bootloader_reset(void)
+{
+	//---reset cmds to SWRST_SIF_ADDR---
+	nvt_write_addr(ts->swrst_sif_addr, 0x69);
+
+	mdelay(5);	//wait tBRST2FR after Bootload RST
