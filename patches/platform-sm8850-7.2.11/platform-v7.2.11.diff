+		.data = &iceland_csot_desc,
+	},
+	{},
+};
+MODULE_DEVICE_TABLE(of, nt36536_of_match);
+
+static struct mipi_dsi_driver nt36536_driver = {
+	.probe = nt36536_probe,
+	.remove = nt36536_remove,
+	.driver = {
+		.name = "panel-novatek-nt36536",
