+/*
+ * Camera I2C bus (QUP wrap2 SE1) is physically shared with the SEE
+ * (ADSP), which owns it by default for AON/virtual camera sensors.
+ * geni_i2c stays disabled: oplus_camres below instantiates it from
+ * this node only while the AP holds the bus, so the SE is untouched
+ * (no firmware load, no interconnect votes) whenever SEE owns it.
+ */
+&i2c9 {
+	status = "disabled";
+
+	/* the dynamically-created geni device must not claim gpio4/5:
+	 * camres owns the pin states for the shared bus */
+	/delete-property/ pinctrl-0;
+	/delete-property/ pinctrl-names;
+};
+
+/*
+ * The special camera i2c bus: camera sensor/VCM children hang here.
+ * Released to the SEE by default; write 1 to force_start_i2c (after
+ * userspace has told SEE to let go) to start I2C on the AP side.
+ */
+&oplus_camres {
+	compatible = "oplus,camres";
+	i2c-bus = <&i2c9>;
+
+	/* camera_handshake SUID (SEE SUID registry) */
+	sns,suid-hi = /bits/ 64 <0xa7167528f835f4ee>;
+	sns,suid-lo = /bits/ 64 <0xe0e3f77b504b96a1>;
+
+	pinctrl-names = "active", "released";
+	pinctrl-0 = <&qup_i2c9_data_clk>;
+	pinctrl-1 = <&qup_i2c9_release>;
+
+	status = "okay";
+
+	camera_rear: camera@36 {
+		compatible = "smartsens,sc1300cs";
+		reg = <0x36>;
+
+		orientation = <1>;
+
+		clocks = <&rpmhcc RPMH_DIV_CLK1>;
+
+		/* vendor drives the pin high while the sensor runs */
+		reset-gpios = <&pmh0110_g_e0_gpios 14 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&cam_rear_mclk_default>, <&cam_rear_rst_default>;
+		pinctrl-names = "default";
+
+		avdd-supply = <&vreg_l14b_2p8>;
+		dvdd-supply = <&vreg_l1f_1p2>;
+		dovdd-supply = <&vreg_l2f_1p8>;
+		afvdd-supply = <&vreg_l16b_2p8>;
+
+		lens-focus = <&camera_rear_vcm>;
+
+		flash-leds = <&pmh0101_flash_led0>;
+
+		port {
+			cam_rear_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				/* 1324.8 Mbit/s per lane (vendor 4160x3120 @ 30 fps) */
+				link-frequencies = /bits/ 64 <662400000>;
+				remote-endpoint = <&csiphy4_ep>;
+			};
+		};
+	};
+
+	/*
+	 * Rear AF actuator, Dongwoon DW9714V (IC INFO 0xfe), vendor 8-bit
+	 * address 0x18. Ringing control tuning from the vendor actuator init:
+	 * RING_EN + SAC2, VCM_FREQ 0x79.
+	 */
+	camera_rear_vcm: camera-lens@c {
+		compatible = "dongwoon,dw9714v";
+		reg = <0x0c>;
+
+		vdd-supply = <&vreg_l16b_2p8>;
+
+		dongwoon,sac-ring-enable;
+		dongwoon,sac-mode = <3>;
+		dongwoon,vcm-prescale = <0x79>;
+	};
+
+	/* Front 8MP, SmartSens SC820CS */
+	camera_front: camera@10 {
+		compatible = "smartsens,sc820cs";
+		reg = <0x10>;
+
+		orientation = <0>;
+
+		clocks = <&rpmhcc RPMH_DIV_CLK1>;
+
+		reset-gpios = <&pmh0110_g_e0_gpios 13 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&cam_front_mclk_default>, <&cam_front_rst_default>;
+		pinctrl-names = "default";
+
+		avdd-supply = <&vreg_l14b_2p8>;
+		dvdd-supply = <&vreg_l1f_1p2>;
+		dovdd-supply = <&vreg_l2f_1p8>;
+
+		port {
+			cam_front_ep: endpoint {
+				data-lanes = <1 2 3 4>;
+				/* 660 Mbit/s per lane (vendor 3264x2448 @ 30 fps) */
+				link-frequencies = /bits/ 64 <330000000>;
+				remote-endpoint = <&csiphy5_ep>;
+			};
+		};
+	};
+};
+
+&i2c14 {
