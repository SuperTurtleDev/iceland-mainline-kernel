+static int tfa9865_init(struct tfa9865_priv *tfa9865)
+{
+	u32 val, version, product = 0;
+	u32 variant = 0;
+	u16 key = 0;
+	int ret;
+
+	enum variant {
+		N = 0,
+		MN = 1
+	};
+
+	regmap_write(tfa9865->regmap, TFA9865_DEVICE_CONTROL, TFA9865_RESET_MASK);
+
+	ret = regmap_read(tfa9865->regmap, TFA9865_PRODUCT, &product);
+	if (ret || product != 0x9866)
+		return dev_err_probe(tfa9865->dev, -EINVAL, "Failed to get product id expected=%x got=%x\n",
+				     0x9866, product);
+
+	regmap_update_bits(tfa9865->regmap, TFA9865_DEVICE_CONTROL, TFA9865_POWERDOWN_MASK, 0);
+	regmap_update_bits(tfa9865->regmap, TFA9865_CLK_CONTROL, TFA9865_MANAOOSC_MASK, 0);
+	regmap_read_poll_timeout(tfa9865->regmap, TFA9865_STATUS2, val,
+				 val & TFA9865_MANSTATE_MASK, 1, 50);
+
+	regmap_read(tfa9865->regmap, 0xf3, &val);
+	if (val & TFA9865_TYPESEL_MASK) {
+		product--; //TFA9865
+		regmap_read(tfa9865->regmap, 0xf4, &val);
+		if (val & TFA9865_LIMITDCDC_MASK)
+			product--; //TFA9864
+	}
+
+	regmap_read(tfa9865->regmap, 0xf0, &val);
+	if (val & TFA9865_NOLPM_MASK)
+		variant = N;
+	else
+		variant = MN;
+
+	regmap_read(tfa9865->regmap, 0x06, &val);
+	version = val >> 8;
+
+	regmap_write(tfa9865->regmap, TFA9865_HIDDEN_CODE, TFA9865_HIDDEN_CODE_VAL);
+	regmap_read(tfa9865->regmap, TFA9865_EFUSE_B, &val);
+	key = val & 0xffff;
+	key = key ^ TFA9865_KEY_UNLOCK;
+	regmap_write(tfa9865->regmap, TFA9865_KEY1, key);
+	regmap_write(tfa9865->regmap, TFA9865_KEY2, TFA9865_KEY_UNLOCK);
+
+	if (product == 0x9864 && version == 0x30 && variant == N) {
+		dev_info(tfa9865->dev, "Found TFA9864 N1\n");
+		regmap_write(tfa9865->regmap, 0x00, 0xf241);
+		regmap_write(tfa9865->regmap, 0x02, 0x0628);
+		regmap_write(tfa9865->regmap, 0x50, 0xc000);
+		regmap_write(tfa9865->regmap, 0x5a, 0x5f4c);
+		regmap_write(tfa9865->regmap, 0x5b, 0x74e2);
+		regmap_write(tfa9865->regmap, 0x5c, 0x302b);
+		regmap_write(tfa9865->regmap, 0x5f, 0x00a0);
+		regmap_write(tfa9865->regmap, 0x62, 0x05c6);
+		regmap_write(tfa9865->regmap, 0x63, 0x80d4);
+		regmap_write(tfa9865->regmap, 0x67, 0x0066);
+		regmap_write(tfa9865->regmap, 0x68, 0x0820);
+		regmap_write(tfa9865->regmap, 0x74, 0x60f0);
+		regmap_write(tfa9865->regmap, 0x75, 0x0e00);
+		regmap_write(tfa9865->regmap, 0x76, 0xbf00);
+		regmap_write(tfa9865->regmap, 0x78, 0x0001);
+		regmap_write(tfa9865->regmap, 0x7c, 0x10f2);
+		regmap_write(tfa9865->regmap, 0xcf, 0x2cd7);
+		regmap_write(tfa9865->regmap, 0xd7, 0x1000);
+		regmap_write(tfa9865->regmap, 0xdd, 0x0036);
+	} else if (product == 0x9864 && version == 0x30 && variant == MN) {
+		dev_info(tfa9865->dev, "Found TFA9864 MN1\n");
+		regmap_write(tfa9865->regmap, 0x00, 0xf241);
+		regmap_write(tfa9865->regmap, 0x02, 0x0628);
+		regmap_write(tfa9865->regmap, 0x50, 0xc000);
+		regmap_write(tfa9865->regmap, 0x5a, 0x5f4c);
+		regmap_write(tfa9865->regmap, 0x5b, 0x74e2);
+		regmap_write(tfa9865->regmap, 0x5c, 0x302b);
+		regmap_write(tfa9865->regmap, 0x5f, 0x00a0);
+		regmap_write(tfa9865->regmap, 0x62, 0x05c6);
+		regmap_write(tfa9865->regmap, 0x63, 0x80d4);
+		regmap_write(tfa9865->regmap, 0x67, 0x0066);
+		regmap_write(tfa9865->regmap, 0x68, 0x0820);
+		regmap_write(tfa9865->regmap, 0x74, 0x60f0);
+		regmap_write(tfa9865->regmap, 0x75, 0x0e00);
+		regmap_write(tfa9865->regmap, 0x76, 0xbf00);
+		regmap_write(tfa9865->regmap, 0x78, 0x0001);
+		regmap_write(tfa9865->regmap, 0x7c, 0x10f2);
+		regmap_write(tfa9865->regmap, 0xcf, 0x2cd7);
+		regmap_write(tfa9865->regmap, 0xd7, 0x1000);
+		regmap_write(tfa9865->regmap, 0xdd, 0x0036);
+	} else if (product == 0x9865 && version == 0x30 && variant == MN) {
+		dev_info(tfa9865->dev, "Found TFA9865 MN1\n");
+		regmap_write(tfa9865->regmap, 0x00, 0xf241);
+		regmap_write(tfa9865->regmap, 0x02, 0x0628);
+		regmap_write(tfa9865->regmap, 0x50, 0xc000);
+		regmap_write(tfa9865->regmap, 0x5a, 0x5f4c);
+		regmap_write(tfa9865->regmap, 0x5b, 0x74e2);
+		regmap_write(tfa9865->regmap, 0x5c, 0x302b);
+		regmap_write(tfa9865->regmap, 0x5f, 0x00a0);
+		regmap_write(tfa9865->regmap, 0x62, 0x05c6);
+		regmap_write(tfa9865->regmap, 0x63, 0x80d4);
+		regmap_write(tfa9865->regmap, 0x67, 0x0066);
+		regmap_write(tfa9865->regmap, 0x68, 0x0820);
+		regmap_write(tfa9865->regmap, 0x74, 0x60f0);
+		regmap_write(tfa9865->regmap, 0x75, 0x0e00);
+		regmap_write(tfa9865->regmap, 0x78, 0x0001);
+		regmap_write(tfa9865->regmap, 0x7c, 0x10f2);
+		regmap_write(tfa9865->regmap, 0xcf, 0x2cd7);
+		regmap_write(tfa9865->regmap, 0xd7, 0x1000);
+		regmap_write(tfa9865->regmap, 0xdd, 0x0036);
+	} else {
+		dev_warn(tfa9865->dev, "Unknown TFA986x version, no optimal settings applied\n");
+	}
+
+
+	regmap_update_bits(tfa9865->regmap, TFA9865_DEVICE_CONTROL, TFA9865_POWERDOWN_MASK,
+			   TFA9865_POWERDOWN_MASK);
+	regmap_read_poll_timeout(tfa9865->regmap, TFA9865_STATUS2, val,
+				 !(val & TFA9865_MANSTATE_MASK), 1, 50);
+	regmap_update_bits(tfa9865->regmap, TFA9865_CLK_CONTROL, TFA9865_MANAOOSC_MASK,
+			   TFA9865_MANAOOSC_MASK);
+
+	regmap_write(tfa9865->regmap, TFA9865_INT_ENABLE, 0x0000);
+	regmap_write(tfa9865->regmap, TFA9865_INT_CLEAR, 0xffff);
+	regmap_write(tfa9865->regmap, TFA9865_INT_ENABLE, 0x071e);
+
+	return 0;
+}
+
+static int tfa9865_i2c_probe(struct i2c_client *i2c)
+{
+	const struct tfa9865_static_config *config;
+	struct tfa9865_priv *tfa9865;
+	u32 devindex = 0;
+	int ret, i;
+
+	tfa9865 = devm_kzalloc(&i2c->dev, sizeof(*tfa9865), GFP_KERNEL);
+	if (!tfa9865)
+		return -ENOMEM;
+
+	i2c_set_clientdata(i2c, tfa9865);
+
+	tfa9865->regmap = devm_regmap_init_i2c(i2c, &tfa9865_regmap);
+	if (IS_ERR(tfa9865->regmap))
+		return PTR_ERR(tfa9865->regmap);
+
+	tfa9865->dev = &i2c->dev;
+
+	ret = devm_regulator_get_enable(tfa9865->dev, "vddio");
+	if (ret)
+		return dev_err_probe(tfa9865->dev, ret, "Failed to get regulator\n");
+
+	tfa9865->reset_gpio = devm_gpiod_get(tfa9865->dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(tfa9865->reset_gpio))
+		return dev_err_probe(tfa9865->dev, PTR_ERR(tfa9865->reset_gpio),
+				     "Failed to get reset GPIO\n");
+
+	gpiod_set_value_cansleep(tfa9865->reset_gpio, 1);
+	usleep_range(1000, 2000);
+	gpiod_set_value_cansleep(tfa9865->reset_gpio, 0);
+	usleep_range(1000, 2000);
+
+	ret = tfa9865_init(tfa9865);
+	if (ret)
+		return dev_err_probe(tfa9865->dev, ret, "Failed to init TFA9865\n");
+
+	config = device_get_match_data(tfa9865->dev);
+	if (config) {
+		of_property_read_u32(tfa9865->dev->of_node, "tfa,devindex", &devindex);
+		if (devindex >= config->dev_count) {
+			dev_err(tfa9865->dev,
+				"devindex %u out of range (max %u)\n",
+				devindex, config->dev_count - 1);
+			return -EINVAL;
+		}
+
+		for (i = 0; i < config->dev_config[devindex].reg_count; i++) {
+			const struct tfa9865_reg_data *reg_data =
+				&config->dev_config[devindex].reg_data[i];
+			ret = regmap_write(tfa9865->regmap, reg_data->reg, reg_data->val);
+			if (ret) {
+				dev_err(tfa9865->dev,
+					"failed to write reg 0x%x val 0x%x ret=%d\n",
+					reg_data->reg, reg_data->val, ret);
+				return ret;
+			}
+		}
+	}
+
+	return devm_snd_soc_register_component(tfa9865->dev, &tfa9865_component,
+					       &tfa9865_dai, 1);
+
+	return 0;
+}
+
+static const struct i2c_device_id tfa9865_i2c_id[] = {
+	{ "tfa9865" },
+	{ }
+};
+MODULE_DEVICE_TABLE(i2c, tfa9865_i2c_id);
+
+static const struct of_device_id tfa9865_of_match[] = {
+	{
+		.compatible = "goodix,tfa9865-iceland",
+		.data = &tfa9865_iceland_config,
+	},
+	{ }
+};
+MODULE_DEVICE_TABLE(of, tfa9865_of_match);
+
+static struct i2c_driver tfa9865_i2c_driver = {
+	.driver = {
+		.name = "tfa9865",
+		.of_match_table = tfa9865_of_match,
+	},
+	.probe = tfa9865_i2c_probe,
+	.id_table = tfa9865_i2c_id,
+};
+
+module_i2c_driver(tfa9865_i2c_driver);
+
+MODULE_DESCRIPTION("ASoC Goodix TFA9865 driver");
+MODULE_AUTHOR("map220v <map220v300@gmail.com>");
+MODULE_LICENSE("GPL");
diff --git a/tools/virt/gunyah/gh_accepttest.py b/tools/virt/gunyah/gh_accepttest.py
new file mode 100644
index 0000000000000000000000000000000000000000..5f2d3b73c973439c963c30319a9e4fdc68fc5d5c
--- /dev/null
+++ b/tools/virt/gunyah/gh_accepttest.py
@@ -0,0 +1,288 @@
+#!/usr/bin/env python3
+"""End-to-end GuestAccept test: the guest really accepts, so UNSHARE must say EBUSY.
+
+Guest = gh_rmproxy.bin (see gh_rmproxy.S): a command loop driven through MMIO
+exits. The host dumps the RM-overlaid DTB to find the RM msgq capabilities,
+frames the RM RPCs itself, and has the guest send/receive them. Checks:
+  - MEM_ACCEPT of a GH_VM_PROTECTED_SHARE handle at a guest-chosen IPA
+  - host->guest and guest->host visibility through the shared buffer
+  - GH_VM_PROTECTED_UNSHARE while accepted -> EBUSY, pages stay pinned
+  - after guest MEM_RELEASE -> UNSHARE succeeds, pins drop
+  - the same for a DMA-BUF (udmabuf) share, including a sliced re-share
+  - shares still accepted at VM fd close are reclaimed after the VM reset
+Run as root. Exit status = number of failures.
+"""
+import ctypes, errno, fcntl, mmap, os, struct, sys, time
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import gh_vmtest as T
+import gh_sharetest as S
+
+RAM_BASE, RAM_SIZE = 0x80000000, 0x400000
+DTB_OFF, DTB_SIZE = 0x200000, 0x10000
+TXBUF, RXBUF = RAM_BASE + 0x100000, RAM_BASE + 0x110000
+GICD, GICR = 0x3FFF0000, 0x3FFD0000
+MMIO = 0x10000000
+ACCEPT_IPA = 0x90000000
+GH_ERROR_MSGQUEUE_EMPTY = 60
+RM_RPC_MEM_ACCEPT, RM_RPC_MEM_RELEASE = 0x51000011, 0x51000014
+
+check, expect_errno = S.check, S.expect_errno
+
+class GuestExited(Exception):
+    pass
+
+class Guest:
+    """Drives gh_rmproxy over MMIO exits. Offsets into struct gunyah_vcpu_run."""
+    def __init__(self, vcpu, run):
+        self.vcpu, self.run, self.exits = vcpu, run, 0
+
+    def _exit(self):
+        while True:
+            fcntl.ioctl(self.vcpu, T.GUNYAH_VCPU_RUN)
+            self.exits += 1
+            reason, = struct.unpack_from("<I", self.run, 8)
+            if reason == 1:
+                pa, data, ln, is_w, _ = struct.unpack_from("<Q8sIBB", self.run, 16)
+                struct.pack_into("<B", self.run, 37, 0)          # resume HANDLED
+                return pa, bool(is_w), ln, data
+            if reason == 2:
+                st, = struct.unpack_from("<I", self.run, 16)
+                raise GuestExited({1: "LOAD_FAILED", 2: "EXITED", 3: "CRASHED"}.get(st, st))
+            if reason == 3:
+                pa, attempt, _ = struct.unpack_from("<QiB", self.run, 16)
+                raise RuntimeError("guest page fault at %#x (%d)" % (pa, attempt))
+            raise RuntimeError("exit_reason %d" % reason)
+
+    def feed(self, value, at):
+        pa, is_w, ln, _ = self._exit()
+        if is_w or pa != at or ln != 8:
+            raise RuntimeError("expected 8-byte read at %#x, got %s len %d at %#x" % (at, "write" if is_w else "read", ln, pa))
+        struct.pack_into("<Q", self.run, 24, value)               # mmio.data
+
+    def take(self):
+        pa, is_w, ln, data = self._exit()
+        if not is_w or pa != MMIO + 8 or ln != 8:
+            raise RuntimeError("expected 8-byte write at DATA, got %s len %d at %#x" % ("write" if is_w else "read", ln, pa))
+        return int.from_bytes(data, "little")
+
+    def cmd(self, c): self.feed(c, MMIO)
+    def arg(self, v): self.feed(v, MMIO + 8)
+
+    def dump(self, addr, nbytes):
+        n = (nbytes + 7) // 8
+        self.cmd(1); self.arg(addr); self.arg(n)
+        return b"".join(self.take().to_bytes(8, "little") for _ in range(n))[:nbytes]
+
+    def load(self, addr, data):
+        data = data + bytes(-len(data) % 8)
+        self.cmd(2); self.arg(addr); self.arg(len(data) // 8)
+        for i in range(0, len(data), 8):
+            self.arg(int.from_bytes(data[i:i + 8], "little"))
+        self.take()     # ack: stores are complete only once the guest has run on past them
+
+    def send(self, cap, buf, size):
+        self.cmd(3); self.arg(cap); self.arg(size); self.arg(buf)
+        return self.take()
+
+    def recv(self, cap, buf, size):
+        self.cmd(4); self.arg(cap); self.arg(buf); self.arg(size)
+        return self.take(), self.take()
+
+    def off(self):
+        self.cmd(5)
+        try:
+            self._exit()
+        except GuestExited as e:
+            return e.args[0]
+        return "no STATUS exit"
+
+def fdt_find_rm_caps(dtb):
+    """(tx_capid, rx_capid) from the node compatible with gunyah-resource-manager."""
+    magic, total, off_struct, off_strings = struct.unpack_from(">IIII", dtb, 0)
+    if magic != 0xd00dfeed:
+        raise RuntimeError("bad FDT magic %#x" % magic)
+    def cstr(off):
+        end = dtb.index(b"\0", off); return dtb[off:end]
+    pos, depth, props, seen = off_struct, 0, [{}], []
+    while True:
+        tok, = struct.unpack_from(">I", dtb, pos); pos += 4
+        if tok == 1:
+            name = cstr(pos); pos = (pos + len(name) + 1 + 3) & ~3
+            props.append({}); depth += 1; seen.append("  " * depth + name.decode())
+        elif tok == 2:
+            p = props.pop(); depth -= 1
+            if b"compatible" in p: seen[-1] += " compatible=%r" % p[b"compatible"] if seen else ""
+            if b"gunyah-resource-manager" in p.get(b"compatible", b""):
+                reg = p[b"reg"]
+                if len(reg) == 16: return struct.unpack(">QQ", reg), p
+                if len(reg) == 8: return struct.unpack(">II", reg), p
+                raise RuntimeError("RM reg has %d bytes" % len(reg))
+        elif tok == 3:
+            ln, nameoff = struct.unpack_from(">II", dtb, pos); pos += 8
+            props[-1][cstr(off_strings + nameoff)] = dtb[pos:pos + ln]; pos = (pos + ln + 3) & ~3
+        elif tok == 4:
+            pass
+        elif tok == 9:
+            raise RuntimeError("no gunyah-resource-manager node in DTB; nodes: %s" % seen)
+        else:
+            raise RuntimeError("bad FDT token %d at %#x" % (tok, pos - 4))
+
+class RM:
+    """RM RPC client: frames here, transport through the guest proxy."""
+    def __init__(self, guest, tx, rx):
+        self.g, self.tx, self.rx, self.seq = guest, tx, rx, 0
+
+    def call(self, msg_id, payload):
+        self.seq = (self.seq + 1) & 0xffff
+        msg = struct.pack("<BBHI", 0x21, 0x01, self.seq, msg_id) + payload
+        self.g.load(TXBUF, msg)
+        err = self.g.send(self.tx, TXBUF, len(msg))
+        if err:
+            raise RuntimeError("msgq_send gunyah_error %d" % err)
+        for _ in range(2000):
+            err, ln = self.g.recv(self.rx, RXBUF, 240)
+            if err == GH_ERROR_MSGQUEUE_EMPTY:
+                time.sleep(0.0005); continue
+            if err:
+                raise RuntimeError("msgq_recv gunyah_error %d" % err)
+            rep = self.g.dump(RXBUF, ln)
+            api, typ, seq, rid, ecode = struct.unpack_from("<BBHII", rep)
+            if (typ & 3) == 2 and seq == self.seq and rid == msg_id:
+                return ecode, rep[12:]
+            print("    (skipping RM message type %#x id %#x)" % (typ, rid))
+        raise RuntimeError("RM reply timeout")
+
+    def mem_accept(self, handle, ipa, size):
+        payload = (struct.pack("<IBBBBI", handle, 0, 2, 0x10 | 0x80, 0, 0)   # NORMAL, SHARE, IPA_CONTIGUOUS|DONE, validate_label=0
+                   + struct.pack("<I", 0)                                       # acl: none (RM uses the stored ACL)
+                   + struct.pack("<HHQQ", 1, 0, ipa, size)                      # one sgl entry
+                   + struct.pack("<HH", 0, 0))                                  # mem attrs: none
+        return self.call(RM_RPC_MEM_ACCEPT, payload)[0]
+
+    def mem_release(self, handle):
+        return self.call(RM_RPC_MEM_RELEASE, struct.pack("<II", handle, 0))[0]
+
+def pattern(nwords, tag):
+    return b"".join(struct.pack("<Q", (tag << 32) | i) for i in range(nwords))
+
+def main():
+    here = os.path.dirname(os.path.abspath(__file__))
+    code = open(os.path.join(here, "gh_rmproxy.bin"), "rb").read()
+    lck_base = S.vmlck_kb()
+
+    dev = os.open("/dev/gunyah", os.O_RDWR)
+    vm = fcntl.ioctl(dev, T.GUNYAH_CREATE_VM)
+    mem, uaddr = S.anon(RAM_SIZE)
+    mem[0:len(code)] = code
+    dtb = T.build_dtb(RAM_BASE, RAM_SIZE, GICD, GICR, rm_rpc=True); mem[DTB_OFF:DTB_OFF + len(dtb)] = dtb
+    fcntl.ioctl(vm, T.GH_VM_ANDROID_LEND_USER_MEM, struct.pack("<IIQQQ", 0, T.MEM_RWX, RAM_BASE, RAM_SIZE, uaddr))
+    fcntl.ioctl(vm, T.GUNYAH_VM_SET_DTB_CONFIG, struct.pack("<QQ", RAM_BASE + DTB_OFF, DTB_SIZE))
+    fcntl.ioctl(vm, T.GUNYAH_VM_SET_BOOT_CONTEXT, struct.pack("<IIQ", T.REG_SET_PC, 0, RAM_BASE))
+    vcpu_arg = ctypes.c_uint32(0)
+    vcpu = fcntl.ioctl(vm, T.GUNYAH_VM_ADD_FUNCTION, bytearray(struct.pack("<IIQ", T.GUNYAH_FN_VCPU, 4, ctypes.addressof(vcpu_arg))), True)
+    run = mmap.mmap(vcpu, fcntl.ioctl(vcpu, T.GUNYAH_VCPU_MMAP_SIZE), flags=mmap.MAP_SHARED, prot=mmap.PROT_READ | mmap.PROT_WRITE)
+    fcntl.ioctl(vm, T.GUNYAH_VM_START)
+    g = Guest(vcpu, run)
+    print("[1] protected VM started with gh_rmproxy (%d B)" % len(code))
+
+    hdr = g.dump(RAM_BASE + DTB_OFF, 8)
+    total = struct.unpack_from(">I", hdr, 4)[0]
+    dtb_out = g.dump(RAM_BASE + DTB_OFF, total)
+    open("/tmp/guest-overlaid.dtb", "wb").write(dtb_out)
+    (tx, rx), rmprops = fdt_find_rm_caps(dtb_out)
+    print("[2] RM-overlaid DTB %d B (%d exits); RM msgq caps tx=%#x rx=%#x" % (total, g.exits, tx, rx))
+    rm = RM(g, tx, rx)
+
+    print("[3] share + guest accept")
+    size = 4 << 20
+    bufA, addrA = S.anon(size)
+    pat = pattern(512, 0xA5A5); bufA[0:len(pat)] = pat
+    bufA[size - 8:size] = struct.pack("<Q", 0x1A57BA5E00000000 | 0x1234)
+    hA = S.share(vm, 7, S.MEM_RW, addrA, size)
+    check("share A 4 MiB label 7", hA not in S.BAD_HANDLES, "handle %#x" % hA)
+    lck_shared = S.vmlck_kb()
+    ecode = rm.mem_accept(hA, ACCEPT_IPA, size - 4096)
+    check("MEM_ACCEPT with wrong size refused by RM", ecode != 0, "err_code %#x" % ecode)
+    ecode = rm.mem_accept(hA, ACCEPT_IPA, size)
+    check("MEM_ACCEPT handle %#x at IPA %#x" % (hA, ACCEPT_IPA), ecode == 0, "err_code %#x" % ecode)
+    if ecode:
+        print("cannot continue without an accepted parcel"); return S.fails + 1
+
+    print("[4] visibility through the shared buffer")
+    got = g.dump(ACCEPT_IPA, len(pat))
+    check("host pattern visible to guest (first 4 KiB)", got == pat, "" if got == pat else "first diff at %d" % next(i for i in range(len(pat)) if got[i] != pat[i]))
+    got = g.dump(ACCEPT_IPA + size - 8, 8)
+    check("last word visible to guest", got == bufA[size - 8:size], got.hex())
+    bufA[0x2000:0x2008] = struct.pack("<Q", 0x5EC0ADDED0000001)        # written after accept
+    check("host write after accept visible to guest", g.dump(ACCEPT_IPA + 0x2000, 8) == bufA[0x2000:0x2008])
+    g.load(ACCEPT_IPA + 0x1000, struct.pack("<Q", 0xDEADBEEFCAFEBABE))
+    check("guest write visible to host", bytes(bufA[0x1000:0x1008]) == struct.pack("<Q", 0xDEADBEEFCAFEBABE), bytes(bufA[0x1000:0x1008]).hex())
+
+    print("[5] UNSHARE while the guest holds the acceptance")
+    expect_errno("UNSHARE label 7 -> EBUSY", lambda: S.unshare(vm, 7), errno.EBUSY)
+    check("pages still pinned after refused UNSHARE", S.vmlck_kb() == lck_shared, "%d kB" % S.vmlck_kb())
+    check("guest still reads the buffer after refused UNSHARE", g.dump(ACCEPT_IPA, 64) == pat[:64])
+    expect_errno("second UNSHARE still EBUSY", lambda: S.unshare(vm, 7), errno.EBUSY)
+
+    print("[6] guest releases, then host unshares")
+    ecode = rm.mem_release(hA)
+    check("MEM_RELEASE handle %#x" % hA, ecode == 0, "err_code %#x" % ecode)
+    S.unshare(vm, 7); check("UNSHARE after release succeeds", True)
+    check("pins dropped", S.vmlck_kb() == lck_shared - (size >> 10), "%d kB" % S.vmlck_kb())
+
+    print("[7] DMA-BUF share (udmabuf over a sealed memfd) accepted by the guest")
+    DSIZE, DIPA = 2 << 20, ACCEPT_IPA + (8 << 20)
+    mfd = os.memfd_create("gh-accept", os.MFD_ALLOW_SEALING)
+    os.ftruncate(mfd, DSIZE)
+    fcntl.fcntl(mfd, fcntl.F_ADD_SEALS, fcntl.F_SEAL_SHRINK)
+    dmem = mmap.mmap(mfd, DSIZE)                       # host view of the exporter's pages
+    dpat = pattern(512, 0xD3A8); dmem[0:len(dpat)] = dpat
+    dmem[DSIZE - 8:DSIZE] = struct.pack("<Q", 0xD3A8E4D000000000 | 0x4321)
+    ud = os.open("/dev/udmabuf", os.O_RDWR)
+    dbuf = fcntl.ioctl(ud, S.UDMABUF_CREATE, bytearray(struct.pack("<IIQQ", mfd, 1, 0, DSIZE)), True)
+    hD = S.share_dmabuf(vm, 9, S.MEM_RW, dbuf, 0, DSIZE)
+    check("share dmabuf 2 MiB label 9", hD not in S.BAD_HANDLES, "handle %#x" % hD)
+    ecode = rm.mem_accept(hD, DIPA, DSIZE)
+    check("MEM_ACCEPT dmabuf handle %#x at IPA %#x" % (hD, DIPA), ecode == 0, "err_code %#x" % ecode)
+    if ecode == 0:
+        check("host pattern in dmabuf visible to guest", g.dump(DIPA, len(dpat)) == dpat)
+        check("last dmabuf word visible to guest", g.dump(DIPA + DSIZE - 8, 8) == dmem[DSIZE - 8:DSIZE])
+        dmem[0x3000:0x3008] = struct.pack("<Q", 0x5EC0ADDED0000002)
+        check("host write to dmabuf after accept visible to guest", g.dump(DIPA + 0x3000, 8) == dmem[0x3000:0x3008])
+        g.load(DIPA + 0x1000, struct.pack("<Q", 0xFEEDFACE0BADF00D))
+        check("guest write to dmabuf visible to host", bytes(dmem[0x1000:0x1008]) == struct.pack("<Q", 0xFEEDFACE0BADF00D), bytes(dmem[0x1000:0x1008]).hex())
+        expect_errno("UNSHARE dmabuf while accepted -> EBUSY", lambda: S.unshare(vm, 9), errno.EBUSY)
+        check("guest still reads dmabuf after refused UNSHARE", g.dump(DIPA, 64) == dpat[:64])
+        check("MEM_RELEASE dmabuf", rm.mem_release(hD) == 0)
+        S.unshare(vm, 9); check("UNSHARE dmabuf after release succeeds", True)
+        check("locked_vm untouched by dmabuf share", S.vmlck_kb() == lck_shared - (size >> 10), "%d kB" % S.vmlck_kb())
+        hD2 = S.share_dmabuf(vm, 9, S.MEM_RW, dbuf, 1 << 20, 1 << 20)
+        check("re-share dmabuf slice [+1 MiB, 1 MiB) label 9", hD2 not in S.BAD_HANDLES, "handle %#x" % hD2)
+        check("accept slice at %#x" % DIPA, rm.mem_accept(hD2, DIPA, 1 << 20) == 0)
+        check("slice maps dmabuf offset +1 MiB (sees host word at +1 MiB)", g.dump(DIPA, 8) == dmem[1 << 20:(1 << 20) + 8])
+        expect_errno("UNSHARE slice while accepted -> EBUSY", lambda: S.unshare(vm, 9), errno.EBUSY)
+        # left accepted on purpose: reclaimed with A and B at teardown below
+
+    print("[8] three live accepted shares at VM teardown")
+    hA2 = S.share(vm, 7, S.MEM_RW, addrA, size)
+    bufB, addrB = S.anon(1 << 20)
+    hB = S.share(vm, 8, S.MEM_R, addrB, 1 << 20)
+    check("re-share A (label 7) + B (label 8)", hA2 not in S.BAD_HANDLES and hB not in S.BAD_HANDLES, "handles %#x %#x" % (hA2, hB))
+    check("re-accept A at same IPA", rm.mem_accept(hA2, ACCEPT_IPA, size) == 0)
+    check("accept B (RO) at %#x" % (ACCEPT_IPA + size), rm.mem_accept(hB, ACCEPT_IPA + size, 1 << 20) == 0)
+    expect_errno("UNSHARE A -> EBUSY", lambda: S.unshare(vm, 7), errno.EBUSY)
+    expect_errno("UNSHARE B -> EBUSY", lambda: S.unshare(vm, 8), errno.EBUSY)
+    dmem[1 << 20:(1 << 20) + 8] = struct.pack("<Q", 0xC0FFEE0000000003)
+    check("dmabuf slice still live at teardown time", g.dump(DIPA, 8) == dmem[1 << 20:(1 << 20) + 8])
+    st = g.off()
+    check("guest SYSTEM_OFF", st == "EXITED", st)
+    expect_errno("UNSHARE A after guest exit, no reset yet -> EBUSY", lambda: S.unshare(vm, 7), errno.EBUSY)
+    run.close(); os.close(vcpu)
+    t0 = time.monotonic(); os.close(vm); dt = (time.monotonic() - t0) * 1000
+    check("locked_vm back to baseline after close (reset released the accepts)", S.vmlck_kb() == lck_base, "%d kB vs %d kB, close %.1f ms" % (S.vmlck_kb(), lck_base, dt))
+    os.close(dev)
+    print("%d failure(s), %d vCPU exits" % (S.fails, g.exits))
+    return S.fails
+
+if __name__ == "__main__":
+    sys.exit(min(main(), 125))
diff --git a/tools/virt/gunyah/gh_rmproxy.S b/tools/virt/gunyah/gh_rmproxy.S
new file mode 100644
index 0000000000000000000000000000000000000000..7bb3c749cf7e904c3a40e1ed3158aca983e350e4
--- /dev/null
+++ b/tools/virt/gunyah/gh_rmproxy.S
@@ -0,0 +1,105 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * gh_rmproxy: minimal bare-metal guest for gh_accepttest.py.
+ *
+ * Runs at EL1 with the MMU off and executes commands the host feeds through
+ * MMIO exits at MMIO_BASE (unmapped in the guest). Every protocol decision --
+ * DTB parsing, RM RPC framing -- lives in the host test; the guest only moves
+ * bytes and issues the two msgq hypercalls. Cache maintenance brackets every
+ * memory access because MMU-off data accesses bypass the caches while the
+ * host's lines for the shared buffer sit in them: clean before a load so the
+ * host's dirty data reaches memory, clean+invalidate around a store so no
+ * dirty host line is written back over it afterwards.
+ *
+ *   CMD  = MMIO_BASE + 0: guest reads the next command
+ *   DATA = MMIO_BASE + 8: guest reads parameters / writes results, 8 bytes each
+ *
+ *   1 DUMP addr count : count x (ldr [addr], str DATA)
+ *   2 LOAD addr count : count x (ldr DATA, str [addr]); then DATA <- 0 as ack
+ *   3 SEND cap size buf : msgq_send(cap, size, buf, PUSH); DATA <- x0
+ *   4 RECV cap buf size : msgq_recv(cap, buf, size);  DATA <- x0, DATA <- x1 (len)
+ *   5 OFF              : PSCI SYSTEM_OFF
+ *
+ * Build: clang --target=aarch64-linux-gnu -c gh_rmproxy.S -o gh_rmproxy.o &&
+ *        llvm-objcopy -O binary -j .text gh_rmproxy.o gh_rmproxy.bin
+ */
+#define MMIO_BASE_HI	0x1000		/* 0x10000000 */
+#define HCALL_MSGQ_SEND	0x801B		/* | 0xC6000000: fast SMC64, vendor hyp */
+#define HCALL_MSGQ_RECV	0x801C
+#define PSCI_SYSTEM_OFF	0x84000008
+
+	.text
+	.globl _start
+_start:
+	movz	x20, #MMIO_BASE_HI, lsl #16
+loop:
+	ldr	x0, [x20]
+	cmp	x0, #1
+	b.eq	do_dump
+	cmp	x0, #2
+	b.eq	do_load
+	cmp	x0, #3
+	b.eq	do_send
+	cmp	x0, #4
+	b.eq	do_recv
+	cmp	x0, #5
+	b.eq	do_off
+	b	loop
+
+do_dump:
+	ldr	x1, [x20, #8]
+	ldr	x2, [x20, #8]
+1:	cbz	x2, loop
+	dc	civac, x1
+	dsb	sy
+	ldr	x3, [x1]
+	str	x3, [x20, #8]
+	add	x1, x1, #8
+	sub	x2, x2, #1
+	b	1b
+
+do_load:
+	ldr	x1, [x20, #8]
+	ldr	x2, [x20, #8]
+1:	cbz	x2, 2f
+	ldr	x3, [x20, #8]
+	dc	civac, x1		/* a dirty host line must not be written back over our store */
+	dsb	sy
+	str	x3, [x1]
+	dc	civac, x1		/* and no stale clean copy may survive for the host to hit */
+	dsb	sy
+	add	x1, x1, #8
+	sub	x2, x2, #1
+	b	1b
+2:	str	xzr, [x20, #8]		/* ack: the host may now read what we stored */
+	b	loop
+
+do_send:
+	ldr	x1, [x20, #8]		/* cap */
+	ldr	x2, [x20, #8]		/* size */
+	ldr	x3, [x20, #8]		/* buf */
+	mov	x4, #1			/* GH_MSGQ_TX_PUSH */
+	mov	x5, #0
+	movz	x0, #HCALL_MSGQ_SEND
+	movk	x0, #0xC600, lsl #16
+	hvc	#0
+	str	x0, [x20, #8]
+	b	loop
+
+do_recv:
+	ldr	x1, [x20, #8]		/* cap */
+	ldr	x2, [x20, #8]		/* buf */
+	ldr	x3, [x20, #8]		/* size */
+	mov	x4, #0
+	movz	x0, #HCALL_MSGQ_RECV
+	movk	x0, #0xC600, lsl #16
+	hvc	#0
+	str	x0, [x20, #8]
+	str	x1, [x20, #8]
+	b	loop
+
+do_off:
+	movz	x0, #(PSCI_SYSTEM_OFF >> 16), lsl #16
+	movk	x0, #(PSCI_SYSTEM_OFF & 0xffff)
+	hvc	#0
+	b	.
diff --git a/tools/virt/gunyah/gh_sharetest.py b/tools/virt/gunyah/gh_sharetest.py
new file mode 100644
index 0000000000000000000000000000000000000000..8a1d9e2d58e588700876da7fdc9aafd5471c928d
--- /dev/null
+++ b/tools/virt/gunyah/gh_sharetest.py
@@ -0,0 +1,154 @@
+#!/usr/bin/env python3
+"""Host-side test of GH_VM_PROTECTED_SHARE / _SHARE_DMABUF / _UNSHARE on a running
+protected VM. The guest here is the gh_vmtest PSCI_OFF stub, so nothing accepts:
+this checks argument validation, handle issue, label bookkeeping, pin accounting,
+the DMA-BUF (udmabuf) source and the reclaim of live shares at VM fd close.
+Run as root (needs /dev/gunyah and /dev/udmabuf). Exit status = number of failures.
+"""
+import ctypes, errno, fcntl, mmap, os, struct, sys, time
+sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
+import gh_vmtest as T
+
+def _IOWR(t, nr, size): return T._IOC(3, t, nr, size)
+GH_VM_PROTECTED_SHARE        = _IOWR("A", 0x18, 40)
+GH_VM_PROTECTED_SHARE_DMABUF = _IOWR("A", 0x19, 40)
+GH_VM_PROTECTED_UNSHARE      = T._IOW("A", 0x1a, 8)
+GH_CAP_PROTECTED_SHARE = 1
+UDMABUF_CREATE = T._IOW("u", 0x42, 24)
+MEM_RW, MEM_R = 0x3, 0x1
+BAD_HANDLES = (0, 0xffffffff)
+
+fails = 0
+def check(name, cond, detail=""):
+    global fails
+    print("  [%s] %s %s" % ("ok " if cond else "FAIL", name, detail))
+    if not cond: fails += 1
+
+def expect_errno(name, fn, err):
+    try:
+        fn(); check(name, False, "unexpectedly succeeded")
+    except OSError as e:
+        check(name, e.errno == err, "errno %d (%s), want %d" % (e.errno, e.strerror, err))
+
+def share(vm, label, flags, uaddr, size, reserved=0):
+    buf = bytearray(struct.pack("<IIQQQII", label, flags, 0, size, uaddr, 0, reserved))
+    fcntl.ioctl(vm, GH_VM_PROTECTED_SHARE, buf, True)
+    return struct.unpack_from("<I", buf, 32)[0]
+
+def share_dmabuf(vm, label, flags, fd, off, size):
+    buf = bytearray(struct.pack("<IIQQQiI", label, flags, 0, size, off, fd, 0))
+    fcntl.ioctl(vm, GH_VM_PROTECTED_SHARE_DMABUF, buf, True)
+    return struct.unpack_from("<I", buf, 36)[0]
+
+def unshare(vm, label, reserved=0):
+    fcntl.ioctl(vm, GH_VM_PROTECTED_UNSHARE, struct.pack("<II", label, reserved))
+
+def vmlck_kb():
+    """account_locked_vm() charges mm->locked_vm, reported as VmLck"""
+    for l in open("/proc/self/status"):
+        if l.startswith("VmLck:"): return int(l.split()[1])
+    return -1
+
+def anon(size):
+    m = mmap.mmap(-1, size, flags=mmap.MAP_PRIVATE | mmap.MAP_ANONYMOUS, prot=mmap.PROT_READ | mmap.PROT_WRITE)
+    m[0:size] = bytes(size)
+    return m, ctypes.addressof(ctypes.c_char.from_buffer(m))
+
+def run_guest_to_exit(vcpu, run):
+    for i in range(8):
+        fcntl.ioctl(vcpu, T.GUNYAH_VCPU_RUN)
+        reason, = struct.unpack_from("<I", run, 8)
+        if reason == 2:
+            st, = struct.unpack_from("<I", run, 16)
+            return {1: "LOAD_FAILED", 2: "EXITED", 3: "CRASHED"}.get(st, st)
+        if reason == 1:
+            struct.pack_into("<B", run, 16 + 8 + 8 + 4 + 1, 0)
+        elif reason == 3:
+            struct.pack_into("<B", run, 16 + 8 + 4, 1)
+    return "no STATUS exit"
+
+def main():
+    RAM_BASE, RAM_SIZE = 0x80000000, 0x400000
+    DTB_OFF, DTB_SIZE = 0x200000, 0x10000
+    GICD, GICR = 0x3FFF0000, 0x3FFD0000
+
+    lck_base = vmlck_kb()   # before any VM memory exists; the VM's own parcels charge locked_vm too
+    dev = os.open("/dev/gunyah", os.O_RDWR)
+    vm = fcntl.ioctl(dev, T.GUNYAH_CREATE_VM)
+    print("[0] VM fd %d" % vm)
+    check("CHECK_EXTENSION(PROTECTED_SHARE) == 1", fcntl.ioctl(vm, T.GH_VM_CHECK_EXTENSION, GH_CAP_PROTECTED_SHARE) == 1)
+
+    bufA, addrA = anon(4 << 20)
+    bufB, addrB = anon(1 << 20)
+    expect_errno("share before VM_START -> ENXIO", lambda: share(vm, 7, MEM_RW, addrA, 4 << 20), errno.ENXIO)
+
+    # Protected VM: lent image whose payload is PSCI SYSTEM_OFF.
+    mem, uaddr = anon(RAM_SIZE)
+    code = struct.pack("<%dI" % len(T.PSCI_OFF), *T.PSCI_OFF); mem[0:len(code)] = code
+    dtb = T.build_dtb(RAM_BASE, RAM_SIZE, GICD, GICR); mem[DTB_OFF:DTB_OFF + len(dtb)] = dtb
+    fcntl.ioctl(vm, T.GH_VM_ANDROID_LEND_USER_MEM, struct.pack("<IIQQQ", 0, T.MEM_RWX, RAM_BASE, RAM_SIZE, uaddr))
+    fcntl.ioctl(vm, T.GUNYAH_VM_SET_DTB_CONFIG, struct.pack("<QQ", RAM_BASE + DTB_OFF, DTB_SIZE))
+    fcntl.ioctl(vm, T.GUNYAH_VM_SET_BOOT_CONTEXT, struct.pack("<IIQ", T.REG_SET_PC, 0, RAM_BASE))
+    vcpu_arg = ctypes.c_uint32(0)
+    vcpu = fcntl.ioctl(vm, T.GUNYAH_VM_ADD_FUNCTION, bytearray(struct.pack("<IIQ", T.GUNYAH_FN_VCPU, 4, ctypes.addressof(vcpu_arg))), True)
+    run = mmap.mmap(vcpu, fcntl.ioctl(vcpu, T.GUNYAH_VCPU_MMAP_SIZE), flags=mmap.MAP_SHARED, prot=mmap.PROT_READ | mmap.PROT_WRITE)
+    fcntl.ioctl(vm, T.GUNYAH_VM_START)
+    print("[1] protected VM started (RUNNING, vCPU not yet run)")
+
+    pin0 = vmlck_kb()
+    print("[2] argument validation")
+    expect_errno("unaligned size -> EINVAL", lambda: share(vm, 7, MEM_RW, addrA, 4096 + 1), errno.EINVAL)
+    expect_errno("zero size -> EINVAL", lambda: share(vm, 7, MEM_RW, addrA, 0), errno.EINVAL)
+    expect_errno("unknown flag -> EINVAL", lambda: share(vm, 7, 0x100, addrA, 4096), errno.EINVAL)
+    expect_errno("reserved != 0 -> EINVAL", lambda: share(vm, 7, MEM_RW, addrA, 4096, reserved=1), errno.EINVAL)
+    expect_errno("unmapped VA -> EFAULT", lambda: share(vm, 7, MEM_RW, 0x10000, 4096), errno.EFAULT)
+    expect_errno("unshare unknown label -> ENOENT", lambda: unshare(vm, 99), errno.ENOENT)
+
+    print("[3] userspace buffer shares")
+    t0 = time.monotonic(); hA = share(vm, 7, MEM_RW, addrA, 4 << 20); dt = (time.monotonic() - t0) * 1000
+    check("share A 4 MiB label 7 RW", hA not in BAD_HANDLES, "handle %#x (%.2f ms)" % (hA, dt))
+    check("VmLck +4 MiB", vmlck_kb() - pin0 == 4096, "%d kB" % (vmlck_kb() - pin0))
+    expect_errno("duplicate label 7 -> EEXIST", lambda: share(vm, 7, MEM_RW, addrB, 1 << 20), errno.EEXIST)
+    check("VmLck unchanged after refused share", vmlck_kb() - pin0 == 4096, "%d kB" % (vmlck_kb() - pin0))
+    hB = share(vm, 8, MEM_R, addrB, 1 << 20)
+    check("share B 1 MiB label 8 RO", hB not in BAD_HANDLES and hB != hA, "handle %#x" % hB)
+    unshare(vm, 7); check("unshare A (guest never accepted)", True)
+    check("VmLck -4 MiB after unshare", vmlck_kb() - pin0 == 1024, "%d kB" % (vmlck_kb() - pin0))
+    hA2 = share(vm, 7, MEM_RW, addrA, 4 << 20)
+    check("re-share A under label 7", hA2 not in BAD_HANDLES, "handle %#x" % hA2)
+
+    print("[4] DMA-BUF (udmabuf over a sealed memfd)")
+    try:
+        mfd = os.memfd_create("gh-share", os.MFD_ALLOW_SEALING)
+        os.ftruncate(mfd, 2 << 20)
+        fcntl.fcntl(mfd, fcntl.F_ADD_SEALS, fcntl.F_SEAL_SHRINK)
+        with mmap.mmap(mfd, 2 << 20) as mm: mm[0:2 << 20] = bytes(2 << 20)
+        ud = os.open("/dev/udmabuf", os.O_RDWR)
+        dbuf = fcntl.ioctl(ud, UDMABUF_CREATE, bytearray(struct.pack("<IIQQ", mfd, 1, 0, 2 << 20)), True)
+        expect_errno("slice past end -> EINVAL", lambda: share_dmabuf(vm, 9, MEM_RW, dbuf, 1 << 20, 2 << 20), errno.EINVAL)
+        expect_errno("wrapping offset -> EOVERFLOW", lambda: share_dmabuf(vm, 9, MEM_RW, dbuf, (1 << 64) - 4096, 8192), errno.EOVERFLOW)
+        expect_errno("non-dmabuf fd -> EINVAL", lambda: share_dmabuf(vm, 9, MEM_RW, mfd, 0, 4096), errno.EINVAL)
+        hD = share_dmabuf(vm, 9, MEM_RW, dbuf, 1 << 20, 1 << 20)
+        check("share dmabuf slice [+1 MiB, 1 MiB) label 9", hD not in BAD_HANDLES, "handle %#x" % hD)
+        unshare(vm, 9); check("unshare dmabuf", True)
+        hD = share_dmabuf(vm, 9, MEM_RW, dbuf, 0, 2 << 20)
+        check("re-share whole dmabuf label 9", hD not in BAD_HANDLES, "handle %#x" % hD)
+        check("VmLck unaffected by dmabuf shares", vmlck_kb() - pin0 == 5120, "%d kB" % (vmlck_kb() - pin0))
+    except OSError as e:
+        check("dmabuf path", False, "setup failed: %s" % e)
+
+    print("[5] guest runs to SYSTEM_OFF with labels 7, 8, 9 still shared")
+    st = run_guest_to_exit(vcpu, run)
+    check("guest exit STATUS EXITED", st == "EXITED", st)
+    expect_errno("share after guest exit -> ENXIO", lambda: share(vm, 10, MEM_RW, addrB, 4096), errno.ENXIO)
+
+    print("[6] close VM fd with live shares -> teardown reclaims")
+    run.close(); os.close(vcpu)
+    t0 = time.monotonic(); os.close(vm); dt = (time.monotonic() - t0) * 1000
+    check("VmLck back to pre-VM baseline after close", vmlck_kb() == lck_base, "%d kB vs %d kB (close %.1f ms)" % (vmlck_kb(), lck_base, dt))
+    os.close(dev)
+    print("%d failure(s)" % fails)
+    return fails
+
+if __name__ == "__main__":
+    sys.exit(min(main(), 125))
diff --git a/tools/virt/gunyah/gh_trace.sh b/tools/virt/gunyah/gh_trace.sh
new file mode 100755
index 0000000000000000000000000000000000000000..0fdb9685745aee2d8d785573b81a74f60da915cb
--- /dev/null
+++ b/tools/virt/gunyah/gh_trace.sh
@@ -0,0 +1,28 @@
+#!/bin/bash
+# Trace the Gunyah demand-paging path while running gh_vmtest.py in the given modes.
+# usage: gh_trace.sh "<mode args>" ...     e.g. gh_trace.sh "shared lend none" "shared lend shm"
+T=/sys/kernel/tracing
+mountpoint -q $T || mount -t tracefs none $T
+echo nop > $T/current_tracer; echo 1 > $T/tracing_on
+echo 0 > $T/events/gh/enable 2>/dev/null
+echo > $T/kprobe_events
+add() { echo "$1" >> $T/kprobe_events || echo "FAILED to add: $1"; }
+add 'p:gh/dp gunyah_rsc_mgr:gunyah_demand_page gpa=$arg2:x64 write=$arg3:u8'
+add 'r:gh/dp_ret gunyah_rsc_mgr:gunyah_demand_page ret=$retval:s32'
+add 'p:gh/pf gunyah_rsc_mgr:gunyah_vm_provide_folio gfn=$arg3:x64 share=$arg4:u8 write=$arg5:u8'
+add 'r:gh/pf_ret gunyah_rsc_mgr:gunyah_vm_provide_folio ret=$retval:s32'
+add 'r:gh/mmio_ret gunyah_vcpu:gunyah_handle_mmio ret=$retval:u8'
+add 'r:gh/pgf_ret gunyah_vcpu:gunyah_handle_page_fault ret=$retval:u8'
+add 'p:gh/res gunyah_rsc_mgr:gunyah_vm_add_resource type=+0($arg2):u32 capid=+8($arg2):x64 label=+40($arg2):u32'
+echo "--- kprobe_events:"; cat $T/kprobe_events
+echo 1 > $T/events/gh/enable || echo "FAILED to enable"
+for args in "$@"; do
+	echo "########## $args"
+	echo > $T/trace
+	dmesg -C
+	timeout 30 python3 /root/gh_vmtest.py $args 2>&1 | grep -v -E '^\[(1|2|4|5|6|6b|7a|7b|7c|7d)\]' | head -14
+	echo "--- dmesg"; dmesg | tail -6
+	echo "--- trace"; grep -v '^#' $T/trace | sed -E 's/^ *[^ ]+ +\[[0-9]+\] [^ ]+ +[0-9.]+: //' | head -40
+done
+echo 0 > $T/events/gh/enable
+echo > $T/kprobe_events
diff --git a/tools/virt/gunyah/gh_vmtest.py b/tools/virt/gunyah/gh_vmtest.py
new file mode 100755
index 0000000000000000000000000000000000000000..7a1d83bdcc9ae31bce75aff8a1de7327f96a700a
--- /dev/null
+++ b/tools/virt/gunyah/gh_vmtest.py
@@ -0,0 +1,193 @@
+#!/usr/bin/env python3
+"""Minimal Gunyah pVM smoke test for /dev/gunyah (unauthenticated VM, 1 vCPU).
+
+usage: gh_vmtest.py [off|mmio|shared] [lend|share] [none|vmmio|shm]
+  3rd arg (shared mode): how the shared region is declared in the DTB: not at all, as
+          gunyah-vm-config/vmmio-ranges, or as a vdevices/shm-0 node (crosvm swiotlb style)
+  off : guest issues PSCI SYSTEM_OFF via HVC               -> expect VCPU exit STATUS/EXITED
+  mmio: guest stores to unmapped 0x10000000, then SYSTEM_OFF -> expect PAGE_FAULT/MMIO exit first
+  shared: protected image + a second SHARE binding at RAM_BASE+4M; guest writes 0x1234 there,
+          host reads it back (kernel demand-pages the shared region on the VMMIO exit, no user exit)
+  lend: use GH_VM_ANDROID_LEND_USER_MEM (protected VM) instead of GH_VM_SET_USER_MEM_REGION
+
+"""
+import ctypes, fcntl, mmap, os, struct, sys, time
+
+# ---- ioctl plumbing --------------------------------------------------------
+def _IOC(d, t, nr, size): return (d << 30) | (size << 16) | (ord(t) << 8) | nr
+def _IO(t, nr): return _IOC(0, t, nr, 0)
+def _IOW(t, nr, size): return _IOC(1, t, nr, size)
+
+GUNYAH_CREATE_VM            = _IO("G", 0x0)
+GH_VM_SET_USER_MEM_REGION   = _IOW("G", 0x1, 32)
+GUNYAH_VM_SET_DTB_CONFIG    = _IOW("G", 0x2, 16)
+GUNYAH_VM_START             = _IO("G", 0x3)
+GUNYAH_VM_ADD_FUNCTION      = _IOW("G", 0x4, 16)
+GUNYAH_VCPU_RUN             = _IO("G", 0x5)
+GUNYAH_VCPU_MMAP_SIZE       = _IO("G", 0x6)
+GUNYAH_VM_SET_BOOT_CONTEXT  = _IOW("G", 0xa, 16)
+GH_VM_ANDROID_LEND_USER_MEM = _IOW("A", 0x11, 32)
+GH_VM_CHECK_EXTENSION       = _IO("A", 0x17)
+GUNYAH_FN_VCPU = 1
+MEM_RWX = 0x7
+REG_SET_PC = 1 << 8
+
+# ---- flat device tree builder ---------------------------------------------
+class FDT:
+    def __init__(self):
+        self.struct = bytearray(); self.strings = bytearray(); self.stroff = {}
+    def _str(self, s):
+        if s not in self.stroff:
+            self.stroff[s] = len(self.strings); self.strings += s.encode() + b"\0"
+        return self.stroff[s]
+    def _pad(self):
+        while len(self.struct) % 4: self.struct += b"\0"
+    def begin(self, name):
+        self.struct += struct.pack(">I", 1) + name.encode() + b"\0"; self._pad()
+    def end(self): self.struct += struct.pack(">I", 2)
+    def prop(self, name, val=b""):
+        self.struct += struct.pack(">III", 3, len(val), self._str(name)) + val; self._pad()
+    def s(self, name, *vals): self.prop(name, b"".join(v.encode() + b"\0" for v in vals))
+    def u32(self, name, *vals): self.prop(name, struct.pack(">%dI" % len(vals), *vals))
+    def u64(self, name, *vals): self.prop(name, struct.pack(">%dQ" % len(vals), *vals))
+    def blob(self):
+        self.struct += struct.pack(">I", 9)
+        hdr = 40; rsv = hdr; st = rsv + 16; strs = st + len(self.struct); total = strs + len(self.strings)
+        return struct.pack(">IIIIIIIIII", 0xd00dfeed, total, st, strs, rsv, 17, 16, 0,
+                           len(self.strings), len(self.struct)) + b"\0" * 16 + bytes(self.struct) + bytes(self.strings)
+
+def build_dtb(ram_base, ram_size, gicd, gicr, shared=None, variant="none", rm_rpc=False):
+    """shared = (gpa, size, label) of an extra SHARE binding, declared per variant
+    rm_rpc: ask the RM for an RM-RPC message queue pair (vdevice-type "rm-rpc"); the RM then
+    generates /hypervisor/qcom,resource-mgr with compatible "gunyah-resource-manager" and
+    reg = <tx_capid rx_capid>, which is what a guest needs to issue MEM_ACCEPT itself"""
+    f = FDT()
+    f.begin("")
+    f.u32("#address-cells", 2); f.u32("#size-cells", 2)
+    f.s("compatible", "linux,dummy-virt"); f.u32("interrupt-parent", 1)
+    f.begin("gunyah-vm-config")
+    f.s("image-name", "iceland-smoke"); f.s("os-type", "linux"); f.s("vm-type", "aarch64-guest")
+    f.begin("memory"); f.u32("#address-cells", 2); f.u32("#size-cells", 2)
+    f.u64("base-address", ram_base); f.u64("size-max", 0x40000000); f.end()
+    f.begin("interrupts"); f.s("config", "/intc"); f.end()
+    f.begin("vcpus"); f.s("affinity", "proxy"); f.end()
+    if shared and variant == "vmmio":
+        f.u64("vmmio-ranges", shared[0], shared[1])
+    f.begin("vdevices"); f.s("generate", "/hypervisor")
+    if rm_rpc:
+        f.begin("rm-rpc"); f.s("vdevice-type", "rm-rpc"); f.s("generate", "/hypervisor/qcom,resource-mgr")
+        f.prop("console-dev"); f.u32("message-size", 0xf0); f.u32("queue-depth", 8); f.u32("qcom,label", 1); f.end()
+    if shared and variant == "shm":
+        f.begin("shm-0"); f.s("vdevice-type", "shm"); f.prop("peer-default"); f.u64("dma_base", 0)
+        f.begin("memory"); f.prop("optional"); f.u32("label", shared[2]); f.u32("#address-cells", 2); f.u64("base", shared[0]); f.end()
+        f.end()
+    f.end()
+    f.end()
+    f.begin("cpus"); f.u32("#address-cells", 1); f.u32("#size-cells", 0)
+    f.begin("cpu@0"); f.s("device_type", "cpu"); f.s("compatible", "arm,armv8"); f.u32("reg", 0)
+    f.s("enable-method", "psci"); f.u32("phandle", 0x100); f.end()
+    f.end()
+    f.begin("memory"); f.s("device_type", "memory"); f.u64("reg", ram_base, ram_size); f.end()  # RM accepts only /memory
+    f.begin("intc"); f.s("compatible", "arm,gic-v3"); f.u32("#interrupt-cells", 3); f.prop("interrupt-controller")
+    f.u32("#address-cells", 2); f.u32("#size-cells", 2); f.u64("reg", gicd, 0x10000, gicr, 0x20000)
+    f.u32("phandle", 1); f.end()
+    f.begin("psci"); f.s("compatible", "arm,psci-1.0", "arm,psci-0.2"); f.s("method", "hvc"); f.end()
+    f.begin("timer"); f.s("compatible", "arm,armv8-timer")
+    f.u32("interrupts", 1, 13, 0x108, 1, 14, 0x108, 1, 11, 0x108, 1, 10, 0x108); f.prop("always-on"); f.end()  # PPI, cpu mask for 1 vCPU, level-low
+    f.begin("chosen"); f.s("bootargs", "console=hvc0"); f.end()
+    f.end()
+    return f.blob()
+
+# ---- guest payload ---------------------------------------------------------
+PSCI_OFF = [0xD2B08000,  # movz x0, #0x8400, lsl #16
+            0xF2800100,  # movk x0, #0x8          -> x0 = 0x84000008 (PSCI SYSTEM_OFF)
+            0xD4000002,  # hvc #0
+            0x14000000]  # b .
+MMIO_THEN_OFF = [0xD2A20000,  # movz x0, #0x1000, lsl #16 -> 0x10000000
+                 0x52824681,  # movz w1, #0x1234
+                 0xB9000001]  # str w1, [x0]
+SHARED_WRITE  = [0xD2B00800,  # movz x0, #0x8040, lsl #16 -> 0x80400000 (second, shared binding)
+                 0x52824681,  # movz w1, #0x1234
+                 0xB9000001]  # str w1, [x0]
+PAYLOADS = {"off": PSCI_OFF, "mmio": MMIO_THEN_OFF + PSCI_OFF, "shared": SHARED_WRITE + PSCI_OFF}
+
+# ---- run -------------------------------------------------------------------
+def main():
+    mode = sys.argv[1] if len(sys.argv) > 1 else "off"
+    lend = len(sys.argv) > 2 and sys.argv[2] == "lend"
+    RAM_BASE, RAM_SIZE = 0x80000000, 0x400000
+    EXTRA_SIZE = 0x400000 if mode == "shared" else 0     # second binding, always SHARE
+    variant = sys.argv[3] if len(sys.argv) > 3 else "none"
+    shared_decl = (RAM_BASE + RAM_SIZE, EXTRA_SIZE, 1) if EXTRA_SIZE else None
+    DTB_OFF, DTB_SIZE = 0x200000, 0x10000
+    GICD, GICR = 0x3FFF0000, 0x3FFD0000
+
+    dev = os.open("/dev/gunyah", os.O_RDWR)
+    vm = fcntl.ioctl(dev, GUNYAH_CREATE_VM)
+    print("[1] CREATE_VM -> vm fd %d; CHECK_EXTENSION(timer_wakeup)=%d" % (vm, fcntl.ioctl(vm, GH_VM_CHECK_EXTENSION, 0)))
+
+    mem = mmap.mmap(-1, RAM_SIZE, flags=mmap.MAP_PRIVATE | mmap.MAP_ANONYMOUS, prot=mmap.PROT_READ | mmap.PROT_WRITE)
+    mem[0:RAM_SIZE] = b"\0" * RAM_SIZE                       # fault pages in
+    uaddr = ctypes.addressof(ctypes.c_char.from_buffer(mem))
+    code = struct.pack("<%dI" % len(PAYLOADS[mode]), *PAYLOADS[mode])
+    mem[0:len(code)] = code
+    dtb = build_dtb(RAM_BASE, RAM_SIZE + EXTRA_SIZE, GICD, GICR, shared_decl, variant)
+    mem[DTB_OFF:DTB_OFF + len(dtb)] = dtb
+    print("[2] guest RAM %d MiB @ %#x (user %#x); payload %d B; dtb %d B @ +%#x" % (RAM_SIZE >> 20, RAM_BASE, uaddr, len(code), len(dtb), DTB_OFF))
+
+    region = struct.pack("<IIQQQ", 0, MEM_RWX, RAM_BASE, RAM_SIZE, uaddr)
+    fcntl.ioctl(vm, GH_VM_ANDROID_LEND_USER_MEM if lend else GH_VM_SET_USER_MEM_REGION, region)
+    print("[3] %s ok" % ("LEND_USER_MEM" if lend else "SET_USER_MEM_REGION"))
+    if EXTRA_SIZE:
+        extra = mmap.mmap(-1, EXTRA_SIZE, flags=mmap.MAP_PRIVATE | mmap.MAP_ANONYMOUS, prot=mmap.PROT_READ | mmap.PROT_WRITE)
+        extra[0:EXTRA_SIZE] = bytes(EXTRA_SIZE)
+        extra_addr = ctypes.addressof(ctypes.c_char.from_buffer(extra))
+        fcntl.ioctl(vm, GH_VM_SET_USER_MEM_REGION, struct.pack("<IIQQQ", 1, MEM_RWX, RAM_BASE + RAM_SIZE, EXTRA_SIZE, extra_addr))
+        print("[3b] SET_USER_MEM_REGION (shared, label 1) %d MiB @ %#x ok, dtb variant=%s" % (EXTRA_SIZE >> 20, RAM_BASE + RAM_SIZE, variant))
+    fcntl.ioctl(vm, GUNYAH_VM_SET_DTB_CONFIG, struct.pack("<QQ", RAM_BASE + DTB_OFF, DTB_SIZE))
+    print("[4] SET_DTB_CONFIG ok")
+    fcntl.ioctl(vm, GUNYAH_VM_SET_BOOT_CONTEXT, struct.pack("<IIQ", REG_SET_PC, 0, RAM_BASE))
+    print("[5] SET_BOOT_CONTEXT pc=%#x ok" % RAM_BASE)
+
+    vcpu_arg = ctypes.c_uint32(0)
+    fn = struct.pack("<IIQ", GUNYAH_FN_VCPU, 4, ctypes.addressof(vcpu_arg))
+    vcpu = fcntl.ioctl(vm, GUNYAH_VM_ADD_FUNCTION, bytearray(fn), True)  # mutable buf -> returns the new fd
+    run_size = fcntl.ioctl(vcpu, GUNYAH_VCPU_MMAP_SIZE)
+    run = mmap.mmap(vcpu, run_size, flags=mmap.MAP_SHARED, prot=mmap.PROT_READ | mmap.PROT_WRITE)
+    print("[6] ADD_FUNCTION(vcpu0) -> fd %d, run page %d B" % (vcpu, run_size))
+
+    t0 = time.monotonic()
+    fcntl.ioctl(vm, GUNYAH_VM_START)
+    print("[7] VM_START ok (%.1f ms)" % ((time.monotonic() - t0) * 1000))
+
+
+    for i in range(8):
+        t0 = time.monotonic()
+        try:
+            fcntl.ioctl(vcpu, GUNYAH_VCPU_RUN)
+        except OSError as e:
+            print("[8.%d] VCPU_RUN -> errno %d (%s)" % (i, e.errno, e.strerror)); break
+        dt = (time.monotonic() - t0) * 1000
+        exit_reason, = struct.unpack_from("<I", run, 8)
+        if exit_reason == 1:
+            pa, data, ln, is_w, act = struct.unpack_from("<Q8sIBB", run, 16)
+            print("[8.%d] exit MMIO %s pa=%#x len=%d data=%s (%.2f ms)" % (i, "write" if is_w else "read", pa, ln, data[:ln].hex(), dt))
+            struct.pack_into("<B", run, 16 + 8 + 8 + 4 + 1, 0)   # resume_action = HANDLED
+        elif exit_reason == 2:
+            st, ty, pad, rsz, reason = struct.unpack_from("<IHHI8s", run, 16)
+            names = {1: "LOAD_FAILED", 2: "EXITED", 3: "CRASHED"}
+            print("[8.%d] exit STATUS %s exit_type=%d reason=%s (%.2f ms)" % (i, names.get(st, st), ty, reason[:rsz].hex(), dt)); break
+        elif exit_reason == 3:
+            pa, attempt, act = struct.unpack_from("<QiB", run, 16)
+            print("[8.%d] exit PAGE_FAULT pa=%#x attempt=%d (%.2f ms) -> resume FAULT" % (i, pa, attempt, dt))
+            struct.pack_into("<B", run, 16 + 8 + 4, 1)           # resume_action = FAULT (inject back)
+        else:
+            print("[8.%d] exit_reason=%d (%.2f ms)" % (i, exit_reason, dt)); break
+    if EXTRA_SIZE:
+        got = bytes(extra[0:4])
+        print("[8x] shared binding word 0 = %s -> %s" % (got.hex(), "guest write visible on host" if got == bytes.fromhex("34120000") else "MISMATCH"))
+    run.close(); os.close(vcpu); os.close(vm); os.close(dev)
+    print("[9] closed")
+
+if __name__ == "__main__":
+    main()
