+};
+
+struct gunyah_vm_binding {
+	enum { VM_MEM_USER, VM_MEM_CMA } mem_type;
+	union {
+		u64 userspace_addr;
+		struct {
+			struct file *file;
+			u32 fd;
+			u64 offset;
+		} cma;
