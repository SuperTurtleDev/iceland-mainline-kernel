+&pmh0110_g_e0_gpios {
+	/*
+	 * Camera reset lines (vendor "CAM_RESET1_1P8" / "CAM_RESET4"):
+	 * level is driven by the sensor driver, this only sets the pad
+	 * config. The vendor active state uses power-source 2, which this
+	 * PMIC's GPIO pads reject upstream (only VIN0/VIN1 exist), so use
+	 * the 1.8 V source like the other pmh0110 states on this board.
+	 */
+	cam_rear_rst_default: cam-rear-rst-default-state {
+		pins = "gpio14";
+		function = "normal";
+		input-disable;
+		output-enable;
+		power-source = <1>; /* 1.8V */
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+	};
+
+	cam_front_rst_default: cam-front-rst-default-state {
+		pins = "gpio13";
+		function = "normal";
+		input-disable;
+		output-enable;
+		power-source = <1>; /* 1.8V */
+		qcom,drive-strength = <PMIC_GPIO_STRENGTH_LOW>;
+	};
+};
