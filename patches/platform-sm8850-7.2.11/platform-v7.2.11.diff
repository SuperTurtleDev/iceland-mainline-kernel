+# Qualcomm Snapdragon 8 Elte Gen 5 (SM8850/SM8850P) config fragment
+CONFIG_LOCALVERSION="-sm8850"
+
+# OnePlus Pad 4/OnePlus Pad 3 Pro/OPPO Pad 5 Pro
+CONFIG_DRM_PANEL_NOVATEK_NT36536=y
+CONFIG_BACKLIGHT_KTZ8869_ICELAND=y
+CONFIG_TOUCHSCREEN_NT36536_SPI=m
+CONFIG_SND_SOC_TFA9865=m
+
+# SOC
+CONFIG_ARM64_PMEM=y
+CONFIG_NR_CPUS=8
+CONFIG_SCHED_CLUSTER=y
+CONFIG_SCSI_UFS_QCOM=y
+CONFIG_QCOM_CPUCP_MBOX=y
+CONFIG_QCOM_LLCC=y
+CONFIG_QCOM_RMTFS_MEM=y
+CONFIG_QCOM_SOCINFO=y
+CONFIG_QCOM_APR=y
+CONFIG_POWER_RESET_QCOM_PON=y
+CONFIG_QCOM_SPMI_TEMP_ALARM=y
+CONFIG_SCSI_UFS_BSG=y
+CONFIG_QCOM_GPI_DMA=y
+CONFIG_I2C_QCOM_GENI=y
+CONFIG_INTERCONNECT_QCOM_OSM_L3=y
+CONFIG_QCOM_ICC_BWMON=y
+CONFIG_QCOM_OCMEM=y
+CONFIG_QCOMTEE=y
+
+CONFIG_PINCTRL_KAANAPALI=y
+CONFIG_CLK_KAANAPALI_CAMCC=y
+CONFIG_CLK_KAANAPALI_DISPCC=y
+CONFIG_CLK_KAANAPALI_GCC=y
+CONFIG_CLK_KAANAPALI_GPUCC=y
+CONFIG_CLK_KAANAPALI_TCSRCC=y
+CONFIG_CLK_KAANAPALI_VIDEOCC=y
+CONFIG_INTERCONNECT_QCOM_KAANAPALI=y
+
+# Sound
+CONFIG_PINCTRL_SM8650_LPASS_LPI=m
+CONFIG_SND_SOC_WCD939X_SDW=m
+CONFIG_SND_SOC_LPASS_RX_MACRO=m
+CONFIG_SND_SOC_LPASS_TX_MACRO=m
+CONFIG_SND_SOC_SC8280XP=m
+
+# PMIC
+CONFIG_NVMEM_SPMI_SDAM=y
+CONFIG_RTC_DRV_PM8XXX=y
+
+# Notification LED
+# Must be builtin as it won't be automatically modprobed
+CONFIG_LEDS_TRIGGER_PATTERN=y
+CONFIG_LEDS_TRIGGER_ONESHOT=y
+CONFIG_LEDS_TRIGGER_BACKLIGHT=y
+CONFIG_LEDS_TRIGGER_ACTIVITY=y
+CONFIG_LEDS_CLASS_MULTICOLOR=m
+CONFIG_LEDS_QCOM_LPG=m
+
+# Flash LED
+CONFIG_LEDS_CLASS_FLASH=y
+CONFIG_LEDS_QCOM_FLASH=m
+
+# Remoteproc
+CONFIG_SLIMBUS=y
+CONFIG_SLIM_QCOM_CTRL=y
+CONFIG_SLIM_QCOM_NGD_CTRL=y
+CONFIG_REMOTEPROC_CDEV=y
+
+# Graphics
+CONFIG_DRM=y
+CONFIG_FB_SIMPLE=y
+CONFIG_DRM_MSM=y
+
+# Brightness Control
+CONFIG_BACKLIGHT_CLASS_DEVICE=y
+
+# Power management
+CONFIG_PM_AUTOSLEEP=y
+CONFIG_PM_WAKELOCKS=y
+
+# MGLRU
+CONFIG_LRU_GEN=y
+CONFIG_LRU_GEN_ENABLED=y
+
+# Misc useful things
+CONFIG_SCSI_SCAN_ASYNC=y
+CONFIG_DMABUF_HEAPS=y
+CONFIG_UDMABUF=y
+CONFIG_DMABUF_HEAPS_CMA=y
+CONFIG_DMABUF_HEAPS_SYSTEM=y
+CONFIG_HZ_1000=y
+CONFIG_MODULE_COMPRESS=y
+CONFIG_MODULE_COMPRESS_ZSTD=y
+CONFIG_MODULE_DECOMPRESS=y
+CONFIG_NTSYNC=m
+CONFIG_SECURITY_LANDLOCK=y
+
+# Needed for mounting userdata on android
+CONFIG_QFMT_V2=y
+
+# HID/Input
+CONFIG_I2C_HID=y
+CONFIG_HID_GENERIC=m
+CONFIG_UHID=m
+CONFIG_USB_HID=m
+CONFIG_INPUT_EVDEV=y
+CONFIG_BT_HIDP=m
+CONFIG_INPUT_JOYDEV=m
+
+# Persistent store
+CONFIG_PSTORE=y
+CONFIG_PSTORE_CONSOLE=y
+CONFIG_PSTORE_PMSG=y
+CONFIG_PSTORE_RAM=y
+CONFIG_PSTORE_COMPRESS=y
+
+# USB
+CONFIG_TYPEC=y
+CONFIG_TYPEC_MUX_WCD939X_USBSS=y
+CONFIG_TYPEC_UCSI=y
+CONFIG_QCOM_PMIC_GLINK=y
+CONFIG_UCSI_PMIC_GLINK=y
+CONFIG_USB_CONFIGFS=y
+CONFIG_USB_CONFIGFS_F_HID=y
+CONFIG_USB_DWC3_ULPI=y
+CONFIG_USB_GADGETFS=m
+CONFIG_PHY_QCOM_M31_EUSB=y
