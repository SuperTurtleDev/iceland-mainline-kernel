 		}
 	} else if (service == SNS_SERVICE_ID && cr->sns_found &&
 		   cr->sns_sq.sq_node == node && cr->sns_sq.sq_port == port) {
-		bool was_ready = cr->session_ready;
-
 		dev_info(cr->dev, "SEE service restart\n");
 		cr->sns_found = false;
