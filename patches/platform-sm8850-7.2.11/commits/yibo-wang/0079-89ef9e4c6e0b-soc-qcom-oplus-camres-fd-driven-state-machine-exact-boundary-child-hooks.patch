 	u64 suid_lo;
-	char attach_name[24];
-	u32 attach_slot;
-	u8 ack_error;		/* from the last ACK */
-	u8 ack_state;
 	struct delayed_work lookup_work;
-	struct delayed_work session_work;
+	struct delayed_work aon_work;
 };
 
