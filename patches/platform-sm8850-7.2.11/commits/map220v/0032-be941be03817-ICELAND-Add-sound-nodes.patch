From be941be038171c2bd68a9eaf1a3f063830c2474d Mon Sep 17 00:00:00 2001
From: map220v <map220v300@gmail.com>
Date: Mon, 6 Jul 2026 18:37:11 +0000
Subject: [PATCH] ICELAND: Add sound nodes

---
 .../dts/qcom/kaanapali-oneplus-iceland.dts    | 168 ++++++++++++++++++
 1 file changed, 168 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index 406f33ac2ca3671955555852fd0aaae7d87df7e6..2c9b36805bafa5a75b8699f37d611aacf31e53c8 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -216,6 +216,71 @@ tz_merged_mem: tz-merged@d8000000 {
 		};
 	};
 
+	sound {
+		compatible = "qcom,kaanapali-sndcard", "qcom,sm8450-sndcard";
+		pinctrl-0 = <&i2s0_default>;
+		pinctrl-names = "default";
+
+		model = "OnePlus-Pad4";
+		audio-routing = "IN1_HPHL", "HPHL_OUT",
+				"IN2_HPHR", "HPHR_OUT",
+				"AMIC1", "MIC BIAS1",
+				"AMIC5", "MIC BIAS1",
+				"TX SWR_INPUT0", "ADC1_OUTPUT",
+				"TX SWR_INPUT1", "ADC2_OUTPUT",
+				"TX SWR_INPUT2", "ADC3_OUTPUT";
+
+		primary-i2s-dai-link {
+			link-name = "Primary MI2S Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai PRIMARY_MI2S_RX>;
+			};
+
+			codec {
+				sound-dai = <&tfa9865_tl>, <&tfa9865_tr>,
+					    <&tfa9865_ml>, <&tfa9865_mr>,
+					    <&tfa9865_bl>, <&tfa9865_br>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		wcd-playback-dai-link {
+			link-name = "WCD Playback";
+
+			cpu {
+				sound-dai = <&q6apmbedai RX_CODEC_DMA_RX_0>;
+			};
+
+			codec {
+				sound-dai = <&wcd939x 0>, <&swr1 0>, <&lpass_rxmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+
+		wcd-capture-dai-link {
+			link-name = "WCD Capture";
+
+			cpu {
+				sound-dai = <&q6apmbedai TX_CODEC_DMA_TX_3>;
+			};
+
+			codec {
+				sound-dai = <&wcd939x 1>, <&swr2 0>, <&lpass_txmacro 0>;
+			};
+
+			platform {
+				sound-dai = <&q6apm>;
+			};
+		};
+	};
+
 	vph_pwr: vph-pwr-regulator {
 		compatible = "regulator-fixed";
 
@@ -814,6 +879,79 @@ &gpu_zap_shader {
 	firmware-name = "qcom/kaanapali/iceland/gen80200_zap.mbn";
 };
 
+&i2c0 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	tfa9865_tl: tfa9865@34 {
+		compatible = "goodix,tfa9865-iceland";
+		reg = <0x34>;
+		//NOTE: TFA resets mistakenly swapped between SE0 and SE22 in downstream
+		reset-gpios = <&tlmm 2 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		tfa,devindex = <0>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "TopLeft";
+	};
+
+	tfa9865_bl: tfa9865@36 {
+		compatible = "goodix,tfa9865-iceland";
+		reg = <0x36>;
+		reset-gpios = <&tlmm 114 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		tfa,devindex = <1>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "BottomLeft";
+	};
+
+	tfa9865_ml: tfa9865@37 {
+		compatible = "goodix,tfa9865-iceland";
+		reg = <0x37>;
+		reset-gpios = <&tlmm 115 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		tfa,devindex = <2>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "MiddleLeft";
+	};
+};
+
+&i2c22 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	tfa9865_tr: tfa9865@34 {
+		compatible = "goodix,tfa9865-iceland";
+		reg = <0x34>;
+		reset-gpios = <&tlmm 160 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		tfa,devindex = <3>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "TopRight";
+	};
+
+	tfa9865_br: tfa9865@36 {
+		compatible = "goodix,tfa9865-iceland";
+		reg = <0x36>;
+		reset-gpios = <&tlmm 116 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		tfa,devindex = <4>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "BottomRight";
+	};
+
+	tfa9865_mr: tfa9865@37 {
+		compatible = "goodix,tfa9865-iceland";
+		reg = <0x37>;
+		reset-gpios = <&tlmm 117 GPIO_ACTIVE_LOW>;
+		vddio-supply = <&vreg_l15b_1p8>;
+		tfa,devindex = <5>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "MiddleRight";
+	};
+};
+
 &i2c3 {
 	status = "okay";
 
@@ -1238,6 +1376,36 @@ wcd_default: wcd-reset-n-active-state {
 		drive-strength = <16>;
 		bias-disable;
 	};
+
+	i2s0_default: i2s0-default-state {
+		sck-pins {
+			pins = "gpio122";
+			function = "i2s0_sck";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data0-pins {
+			pins = "gpio123";
+			function = "i2s0_data0";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		data1-pins {
+			pins = "gpio124";
+			function = "i2s0_data1";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		ws-pins {
+			pins = "gpio125";
+			function = "i2s0_ws";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
 };
 
 &uart7 {
