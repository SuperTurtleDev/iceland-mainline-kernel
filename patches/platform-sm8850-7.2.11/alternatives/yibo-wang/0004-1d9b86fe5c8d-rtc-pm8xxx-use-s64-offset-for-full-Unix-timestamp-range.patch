From 1d9b86fe5c8dcc38c9e25f5e59d12a94850c200d Mon Sep 17 00:00:00 2001
From: Yibo Wang <2024312277@stu.hit.edu.cn>
Date: Wed, 7 Oct 2026 13:37:49 -0500
Subject: [PATCH] rtc: pm8xxx: use s64 offset for full Unix timestamp range

The u32 offset limited the RTC to timestamps 0..4294967295 (1970-2106).
Switch to s64 throughout the offset path so pre-1970 and post-2106
timestamps work like on a PC. The raw PMIC counter stays u32 (hardware
limit); the nvmem cell expands from 4 to 8 bytes to hold the s64 offset.

Signed-off-by: Yibo Wang <2024312277@stu.hit.edu.cn>
---
 .../dts/qcom/kaanapali-oneplus-iceland.dts    |  4 +-
 drivers/rtc/rtc-pm8xxx.c                      | 41 +++++++++++--------
 2 files changed, 25 insertions(+), 20 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index ed2cf9f84a01698b62fe14b554a49e5593478847..a0481d990433df7cde8cd0f0360ac5332a51db6c 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -1026,13 +1026,13 @@ &mdss {
 
 /*
  * HLOS cannot write the PMIC RTC counter (owned by TZ), so the driver
- * persists a UTC offset in SDAM instead.  Slot 0x7c-0x7f in SDAM2:
+ * persists a UTC offset in SDAM instead.  Slot 0x7c-0x83 in SDAM2:
  * free of Android HLOS cells (0x48-0x7b), verified to persist across
  * reboots (marker test 2026-10-07).
  */
 &pmk8850_sdam_2 {
 	rtc_offset: rtc-offset@7c {
-		reg = <0x7c 0x4>;
+		reg = <0x7c 0x8>;
 	};
 };
 
diff --git a/drivers/rtc/rtc-pm8xxx.c b/drivers/rtc/rtc-pm8xxx.c
index e624f848c22b5799d23107518bbfd01b2e93d150..c0cf54534014b83f236f9064a2cb2b9ef399fafb 100644
--- a/drivers/rtc/rtc-pm8xxx.c
+++ b/drivers/rtc/rtc-pm8xxx.c
@@ -64,7 +64,8 @@ struct qcom_uefi_rtc_info {
  * @dev:		device structure
  * @rtc_info:		qcom uefi rtc-info structure
  * @nvmem_cell:		nvmem cell for offset
- * @offset:		offset from epoch in seconds
+ * @offset:		offset from epoch in seconds (s64 for full Unix
+ *			timestamp range)
  * @offset_dirty:	offset needs to be stored on shutdown
  */
 struct pm8xxx_rtc {
@@ -77,7 +78,7 @@ struct pm8xxx_rtc {
 	struct device *dev;
 	struct qcom_uefi_rtc_info rtc_info;
 	struct nvmem_cell *nvmem_cell;
-	u32 offset;
+	s64 offset;
 	bool offset_dirty;
 };
 
@@ -180,25 +181,25 @@ static int pm8xxx_rtc_read_nvmem_offset(struct pm8xxx_rtc *rtc_dd)
 		return rc;
 	}
 
-	if (len != sizeof(u32)) {
+	if (len != sizeof(s64)) {
 		dev_dbg(rtc_dd->dev, "unexpected nvmem cell size %zu\n", len);
 		kfree(buf);
 		return -EINVAL;
 	}
 
-	rtc_dd->offset = get_unaligned_le32(buf);
+	rtc_dd->offset = get_unaligned_le64(buf);
 
 	kfree(buf);
 
 	return 0;
 }
 
-static int pm8xxx_rtc_write_nvmem_offset(struct pm8xxx_rtc *rtc_dd, u32 offset)
+static int pm8xxx_rtc_write_nvmem_offset(struct pm8xxx_rtc *rtc_dd, s64 offset)
 {
-	u8 buf[sizeof(u32)];
+	u8 buf[sizeof(s64)];
 	int rc;
 
-	put_unaligned_le32(offset, buf);
+	put_unaligned_le64(offset, buf);
 
 	rc = nvmem_cell_write(rtc_dd->nvmem_cell, buf, sizeof(buf));
 	if (rc < 0) {
@@ -240,10 +241,10 @@ static int pm8xxx_rtc_read_raw(struct pm8xxx_rtc *rtc_dd, u32 *secs)
 	return 0;
 }
 
-static int pm8xxx_rtc_update_offset(struct pm8xxx_rtc *rtc_dd, u32 secs)
+static int pm8xxx_rtc_update_offset(struct pm8xxx_rtc *rtc_dd, s64 secs)
 {
 	u32 raw_secs;
-	u32 offset;
+	s64 offset;
 	int rc;
 
 	if (!rtc_dd->nvmem_cell && !rtc_dd->use_uefi)
@@ -345,7 +346,7 @@ static int __pm8xxx_rtc_set_time(struct pm8xxx_rtc *rtc_dd, u32 secs)
 static int pm8xxx_rtc_set_time(struct device *dev, struct rtc_time *tm)
 {
 	struct pm8xxx_rtc *rtc_dd = dev_get_drvdata(dev);
-	u32 secs;
+	time64_t secs;
 	int rc;
 
 	secs = rtc_tm_to_time64(tm);
@@ -358,26 +359,29 @@ static int pm8xxx_rtc_set_time(struct device *dev, struct rtc_time *tm)
 	if (rc)
 		return rc;
 
-	dev_dbg(dev, "set time: %ptRd %ptRt (%u + %u)\n", tm, tm,
-			secs - rtc_dd->offset, rtc_dd->offset);
+	dev_dbg(dev, "set time: %ptRd %ptRt (%lld + %lld)\n", tm, tm,
+		(long long)(secs - rtc_dd->offset),
+		(long long)rtc_dd->offset);
 	return 0;
 }
 
 static int pm8xxx_rtc_read_time(struct device *dev, struct rtc_time *tm)
 {
 	struct pm8xxx_rtc *rtc_dd = dev_get_drvdata(dev);
-	u32 secs;
+	u32 raw_secs;
+	s64 secs;
 	int rc;
 
-	rc = pm8xxx_rtc_read_raw(rtc_dd, &secs);
+	rc = pm8xxx_rtc_read_raw(rtc_dd, &raw_secs);
 	if (rc)
 		return rc;
 
-	secs += rtc_dd->offset;
+	secs = (s64)raw_secs + rtc_dd->offset;
 	rtc_time64_to_tm(secs, tm);
 
-	dev_dbg(dev, "read time: %ptRd %ptRt (%u + %u)\n", tm, tm,
-			secs - rtc_dd->offset, rtc_dd->offset);
+	dev_dbg(dev, "read time: %ptRd %ptRt (%lld + %lld)\n", tm, tm,
+		(long long)(secs - rtc_dd->offset),
+		(long long)rtc_dd->offset);
 	return 0;
 }
 
@@ -638,7 +642,8 @@ static int pm8xxx_rtc_probe(struct platform_device *pdev)
 		return PTR_ERR(rtc_dd->rtc);
 
 	rtc_dd->rtc->ops = &pm8xxx_rtc_ops;
-	rtc_dd->rtc->range_max = U32_MAX;
+	/* The raw counter is u32 but the s64 offset extends the range */
+	rtc_dd->rtc->range_max = RTC_TIMESTAMP_END_9999;
 
 	if (rtc_dd->alarm_irq) {
 		rc = devm_request_any_context_irq(&pdev->dev, rtc_dd->alarm_irq,
