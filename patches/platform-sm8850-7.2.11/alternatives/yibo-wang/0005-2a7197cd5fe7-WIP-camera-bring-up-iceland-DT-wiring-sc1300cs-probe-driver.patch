 drivers/media/i2c/Kconfig                     |  13 +
 drivers/media/i2c/Makefile                    |   1 +
 drivers/media/i2c/sc1300cs.c                  | 316 ++++++++++++++++++
 6 files changed, 763 insertions(+)
