index 0000000000000000000000000000000000000000..4374aa5a4c2c94ea71fbf2fa17189ef6160b850b
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/smartsens,sc1300cs.yaml
@@ -0,0 +1,111 @@
+# SPDX-License-Identifier: (GPL-2.0 OR BSD-2-Clause)
+# Copyright (c) 2026 OnePlus Pad 4 mainline effort
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/smartsens,sc1300cs.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: SmartSens SC1300CS / SC820CS raw MIPI CSI-2 sensors
+
+maintainers:
+  - Yibo Wang <yibo.wang@example.invalid>
+
+description: |
+  The SmartSens SC1300CS is a 13 MP PDAF raw Bayer sensor and the SC820CS
+  an 8 MP fixed-focus raw Bayer sensor, both with a MIPI CSI-2 image data
+  interface and an I2C-compatible control bus.  Register tables are not
+  publicly available; the mainline driver covers power sequencing and
+  chip identification only.
+
+properties:
+  compatible:
+    enum:
+      - smartsens,sc1300cs
+      - smartsens,sc820cs
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    description: XCLK input, 19.2 MHz on the OnePlus Pad 4 (RPMh DIV_CLK1).
+    maxItems: 1
+
+  avdd-supply: true
+
+  dvdd-supply: true
+
+  dovdd-supply: true
+
+  reset-gpios:
+    description: Reference to the GPIO connected to the XCLR pin (active low).
+    maxItems: 1
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        unevaluatedProperties: false
+
+        properties:
+          data-lanes:
+            oneOf:
+              - items:
+                  - const: 1
+                  - const: 2
+                  - const: 3
+                  - const: 4
+              - items:
+                  - const: 1
+                  - const: 2
+
+          link-frequencies: true
+
+        required:
+          - data-lanes
+
+    required:
+      - endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dvdd-supply
+  - dovdd-supply
+  - port
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        sensor@36 {
+            compatible = "smartsens,sc1300cs";
+            reg = <0x36>;
+
+            clocks = <&rpmhcc 17>;
+
+            reset-gpios = <&pmic_gpios 14 GPIO_ACTIVE_LOW>;
+
+            avdd-supply = <&camera_avdd_2p8>;
+            dvdd-supply = <&camera_dvdd_1p2>;
+            dovdd-supply = <&camera_dovdd_1p8>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csiphy_in>;
+                    data-lanes = <1 2 3 4>;
+                };
+            };
+        };
+    };
+...
diff --git a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
index ed2cf9f84a01698b62fe14b554a49e5593478847..c46e95ce75db7e1319b5cca521292b4f7f11bda4 100644
--- a/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
+++ b/arch/arm64/boot/dts/qcom/kaanapali-oneplus-iceland.dts
@@ -1020,6 +1020,68 @@ backlight@11 {
 	};
 };
 
+/*
+ * Camera sensors on QUPv3 SE9 (GENI I2C).  Wiring from the stock dtbo
+ * (fragment@97): rear reg 0x6c is the vendor 8-bit form of 7-bit 0x36,
+ * front 0x20 -> 0x10; both on CSIPHY4/5, reset on PMH0110-G gpio14/13,
+ * MCLK = RPMh DIV_CLK1 (19.2 MHz) on PMK8850 gpio2/gpio1 func2.
+ * Compatible/model names are provisional until the chip IDs (0x3107 =
+ * 0xc658 rear / 0xd154 front) have been read on hardware.
+ */
+&i2c9 {
+	clock-frequency = <400000>;
+
+	status = "okay";
+
+	rear_cam: camera@36 {
+		compatible = "smartsens,sc1300cs";
+		reg = <0x36>;
+
+		clocks = <&rpmhcc RPMH_DIV_CLK1>;
+		clock-names = "xclk";
+
+		avdd-supply = <&vreg_l14b_2p8>;
+		dvdd-supply = <&vreg_l1f_1p2>;
+		dovdd-supply = <&vreg_l2f_1p8>;
+
+		reset-gpios = <&pmh0110_g_e0_gpios 14 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&cam_mclk_rear_active &cam_rst_rear_active>;
+		pinctrl-names = "default";
+
+		port {
+			rear_cam_ep: endpoint {
+				remote-endpoint = <&csiphy4_in>;
+				data-lanes = <1 2 3 4>;
+			};
+		};
+	};
+
+	front_cam: camera@10 {
+		compatible = "smartsens,sc820cs";
+		reg = <0x10>;
+
+		clocks = <&rpmhcc RPMH_DIV_CLK1>;
+		clock-names = "xclk";
+
+		avdd-supply = <&vreg_l14b_2p8>;
+		dvdd-supply = <&vreg_l1f_1p2>;
+		dovdd-supply = <&vreg_l2f_1p8>;
+
+		reset-gpios = <&pmh0110_g_e0_gpios 13 GPIO_ACTIVE_LOW>;
+
+		pinctrl-0 = <&cam_mclk_front_active &cam_rst_front_active>;
+		pinctrl-names = "default";
+
+		port {
+			front_cam_ep: endpoint {
+				remote-endpoint = <&csiphy5_in>;
+				data-lanes = <1 2>;
+			};
+		};
+	};
+};
+
 &mdss {
 	status = "okay";
 };
@@ -1259,6 +1321,45 @@ pogo_kbd_power_default: pogo-kbd-power-default-state {
 	};
 };
 
+&pmh0110_g_e0_gpios {
+	/* vendor CAM_RESET1_1P8 (rear), released = physical high */
+	cam_rst_rear_active: cam-rst-rear-active-state {
+		pins = "gpio14";
+		function = "normal";
+		input-disable;
+		output-enable;
+		power-source = <2>;
+		qcom,drive-strength = <2>;
+	};
+
+	/* vendor CAM_RESET4 (front), released = physical high */
+	cam_rst_front_active: cam-rst-front-active-state {
+		pins = "gpio13";
+		function = "normal";
+		input-disable;
+		output-enable;
+		power-source = <2>;
+		qcom,drive-strength = <2>;
+	};
+};
+
+&pmk8850_gpios {
+	/* sensor MCLK pads: RPMh DIV_CLK1 (19.2 MHz) routed out on func2 */
+	cam_mclk_rear_active: cam-mclk-rear-active-state {
+		pins = "gpio2";
+		function = "func2";
+		output-enable;
+		power-source = <0>;
+	};
+
+	cam_mclk_front_active: cam-mclk-front-active-state {
+		pins = "gpio1";
+		function = "func2";
+		output-enable;
+		power-source = <0>;
+	};
+};
+
 &pmih0108_e1_eusb2_repeater {
 	vdd18-supply = <&vreg_l15b_1p8>;
 	vdd3-supply = <&vreg_l5b_3p1>;
@@ -1573,3 +1674,51 @@ &usb_dp_qmpphy {
 
 	status = "okay";
 };
+
+/*
+ * CSIPHY supplies: the v14-era driver bulk-gets all six 0p8/1p2 pairs,
+ * so every property must exist.  Rail assignment follows the Qualcomm
+ * kaanapali MTP reference design (vdda-0p9 = l3d, vdda-1p2 = l1d); those
+ * rails are shared with PCIe/USB phys on this board as well.
+ */
+&camss {
+	vdd-csiphy0-0p8-supply = <&vreg_l3d_0p8>;
+	vdd-csiphy0-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy1-0p8-supply = <&vreg_l3d_0p8>;
+	vdd-csiphy1-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy2-0p8-supply = <&vreg_l3d_0p8>;
+	vdd-csiphy2-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy3-0p8-supply = <&vreg_l3d_0p8>;
+	vdd-csiphy3-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy4-0p8-supply = <&vreg_l3d_0p8>;
+	vdd-csiphy4-1p2-supply = <&vreg_l1d_1p2>;
+	vdd-csiphy5-0p8-supply = <&vreg_l3d_0p8>;
+	vdd-csiphy5-1p2-supply = <&vreg_l1d_1p2>;
+
+	status = "okay";
+
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* rear 13 MP: CSIPHY4 */
+		port@4 {
+			reg = <4>;
+
+			csiphy4_in: endpoint {
+				data-lanes = <1 2 3 4>;
+				remote-endpoint = <&rear_cam_ep>;
+			};
+		};
+
+		/* front 8 MP: CSIPHY5 */
+		port@5 {
+			reg = <5>;
+
+			csiphy5_in: endpoint {
+				data-lanes = <1 2>;
+				remote-endpoint = <&front_cam_ep>;
+			};
+		};
+	};
+};
