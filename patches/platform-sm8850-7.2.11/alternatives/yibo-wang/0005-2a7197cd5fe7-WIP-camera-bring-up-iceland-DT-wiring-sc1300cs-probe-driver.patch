index 0000000000000000000000000000000000000000..e79efa5cd79db88d186d6b5b5a30a45606613750
--- /dev/null
+++ b/drivers/media/i2c/sc1300cs.c
@@ -0,0 +1,316 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * SmartSens SC1300CS / SC820CS camera sensor bring-up driver
+ *
+ * OnePlus Pad 4 (iceland) rear (13 MP, PDAF) and front (8 MP) sensors sit
+ * on QUP SE9 GENI I2C and are SmartSens parts with no mainline driver.
+ * This driver implements the power-on sequence (dovdd -> avdd/dvdd,
+ * 19.2 MHz RPMh DIV_CLK1 xclk, PMIC reset GPIO) and verifies the chip ID
+ * at registers 0x3107/0x3108, which is what the stock firmware reads
+ * (ftm_setting_compatible: 0xc658 rear, 0xd154 front).
+ *
+ * BRING-UP SCOPE: no register tables yet, so no mode/stream support.
+ * Probe success + chip ID in dmesg validates regulators, reset, MCLK and
+ * the I2C address translation (vendor DT uses 8-bit forms 0x6c/0x20).
+ * Model names remain provisional until the IDs are confirmed on hardware.
+ */
+
+#include <linux/clk.h>
+#include <linux/delay.h>
+#include <linux/device.h>
+#include <linux/err.h>
+#include <linux/gpio/consumer.h>
+#include <linux/i2c.h>
+#include <linux/module.h>
+#include <linux/pm_runtime.h>
+#include <linux/regulator/consumer.h>
+
+#include <media/v4l2-cci.h>
+#include <media/v4l2-common.h>
+#include <media/v4l2-ctrls.h>
+#include <media/v4l2-subdev.h>
+
+#define SC13XX_REG_CHIP_ID		CCI_REG16(0x3107)
+#define SC13XX_REG_MODE_SELECT		CCI_REG8(0x0100)
+#define SC13XX_MODE_STANDBY		0x01
+
+#define SC13XX_XCLK_FREQ		19200000
+
+struct sc13xx {
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct regmap *regmap;
+
+	struct regulator *avdd;
+	struct regulator *dvdd;
+	struct regulator *dovdd;
+	struct clk *xclk;
+	struct gpio_desc *reset;
+
+	const struct sc13xx_cfg *cfg;
+};
+
+struct sc13xx_cfg {
+	const char *model;
+	u16 chip_id;
+};
+
+#define to_sc13xx(sd)	container_of(sd, struct sc13xx, sd)
+
+static const struct sc13xx_cfg sc1300cs_cfg = {
+	.model = "sc1300cs",
+	.chip_id = 0xc658,
+};
+
+static const struct sc13xx_cfg sc820cs_cfg = {
+	.model = "sc820cs",
+	.chip_id = 0xd154,
+};
+
+static int sc13xx_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sc13xx *sc13xx = to_sc13xx(sd);
+	int ret;
+
+	/* XCLR is active low: assert (drive low) across power-up */
+	gpiod_set_value_cansleep(sc13xx->reset, 1);
+
+	ret = regulator_enable(sc13xx->dovdd);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to enable dovdd\n");
+
+	ret = regulator_enable(sc13xx->avdd);
+	if (ret)
+		goto err_dovdd;
+
+	ret = regulator_enable(sc13xx->dvdd);
+	if (ret)
+		goto err_avdd;
+
+	ret = clk_prepare_enable(sc13xx->xclk);
+	if (ret)
+		goto err_dvdd;
+
+	usleep_range(1000, 2000);
+
+	/* release XCLR */
+	gpiod_set_value_cansleep(sc13xx->reset, 0);
+
+	/* SmartSens init time after XCLR high */
+	usleep_range(20000, 22000);
+
+	return 0;
+
+err_dvdd:
+	regulator_disable(sc13xx->dvdd);
+err_avdd:
+	regulator_disable(sc13xx->avdd);
+err_dovdd:
+	regulator_disable(sc13xx->dovdd);
+	gpiod_set_value_cansleep(sc13xx->reset, 0);
+	return ret;
+}
+
+static int sc13xx_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct sc13xx *sc13xx = to_sc13xx(sd);
+
+	/* best effort: standby before cutting rails */
+	cci_write(sc13xx->regmap, SC13XX_REG_MODE_SELECT,
+		  SC13XX_MODE_STANDBY, NULL);
+
+	clk_disable_unprepare(sc13xx->xclk);
+
+	regulator_disable(sc13xx->dvdd);
+	regulator_disable(sc13xx->avdd);
+	regulator_disable(sc13xx->dovdd);
+
+	gpiod_set_value_cansleep(sc13xx->reset, 1);
+
+	return 0;
+}
+
+static int sc13xx_identify(struct sc13xx *sc13xx)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sc13xx->sd);
+	u64 chip_id = 0;
+	int ret;
+
+	ret = cci_read(sc13xx->regmap, SC13XX_REG_CHIP_ID, &chip_id, NULL);
+	if (ret)
+		return dev_err_probe(&client->dev, ret,
+				     "failed to read chip ID\n");
+
+	if (chip_id != sc13xx->cfg->chip_id) {
+		dev_err(&client->dev,
+			"unexpected chip ID 0x%04llx, expected 0x%04x (%s)\n",
+			(unsigned long long)chip_id, sc13xx->cfg->chip_id,
+			sc13xx->cfg->model);
+		return -ENODEV;
+	}
+
+	dev_info(&client->dev, "%s identified, chip ID 0x%04llx\n",
+		 sc13xx->cfg->model, (unsigned long long)chip_id);
+
+	return 0;
+}
+
+static int sc13xx_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_mbus_framefmt *fmt;
+
+	fmt = v4l2_subdev_state_get_format(state, 0);
+
+	/* placeholder until register tables land */
+	fmt->code = MEDIA_BUS_FMT_SBGGR10_1X10;
+	fmt->width = 2112;
+	fmt->height = 1560;
+
+	return 0;
+}
+
+static const struct v4l2_subdev_internal_ops sc13xx_internal_ops = {
+	.init_state = sc13xx_init_state,
+};
+
+static const struct v4l2_subdev_ops sc13xx_subdev_ops = {
+};
+
+static int sc13xx_get_pm_resources(struct sc13xx *sc13xx)
+{
+	struct i2c_client *client = v4l2_get_subdevdata(&sc13xx->sd);
+
+	sc13xx->dovdd = devm_regulator_get(&client->dev, "dovdd");
+	if (IS_ERR(sc13xx->dovdd))
+		return PTR_ERR(sc13xx->dovdd);
+
+	sc13xx->avdd = devm_regulator_get(&client->dev, "avdd");
+	if (IS_ERR(sc13xx->avdd))
+		return PTR_ERR(sc13xx->avdd);
+
+	sc13xx->dvdd = devm_regulator_get(&client->dev, "dvdd");
+	if (IS_ERR(sc13xx->dvdd))
+		return PTR_ERR(sc13xx->dvdd);
+
+	sc13xx->reset = devm_gpiod_get_optional(&client->dev, "reset",
+						GPIOD_OUT_HIGH);
+	if (IS_ERR(sc13xx->reset))
+		return PTR_ERR(sc13xx->reset);
+
+	sc13xx->xclk = devm_clk_get(&client->dev, "xclk");
+	if (IS_ERR(sc13xx->xclk))
+		return PTR_ERR(sc13xx->xclk);
+
+	return 0;
+}
+
+static int sc13xx_probe(struct i2c_client *client)
+{
+	struct sc13xx *sc13xx;
+	int ret;
+
+	sc13xx = devm_kzalloc(&client->dev, sizeof(*sc13xx), GFP_KERNEL);
+	if (!sc13xx)
+		return -ENOMEM;
+
+	sc13xx->cfg = device_get_match_data(&client->dev);
+	if (!sc13xx->cfg)
+		return -ENODEV;
+
+	sc13xx->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(sc13xx->regmap))
+		return PTR_ERR(sc13xx->regmap);
+
+	v4l2_i2c_subdev_init(&sc13xx->sd, client, &sc13xx_subdev_ops);
+	sc13xx->sd.internal_ops = &sc13xx_internal_ops;
+
+	ret = sc13xx_get_pm_resources(sc13xx);
+	if (ret)
+		return ret;
+
+	ret = sc13xx_power_on(&client->dev);
+	if (ret)
+		return ret;
+
+	ret = sc13xx_identify(sc13xx);
+	if (ret)
+		goto err_power_off;
+
+	sc13xx->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	sc13xx->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	sc13xx->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&sc13xx->sd.entity, 1, &sc13xx->pad);
+	if (ret)
+		goto err_power_off;
+
+	ret = v4l2_subdev_init_finalize(&sc13xx->sd);
+	if (ret)
+		goto err_entity_cleanup;
+
+	pm_runtime_set_active(&client->dev);
+	pm_runtime_enable(&client->dev);
+	pm_runtime_idle(&client->dev);
+
+	ret = v4l2_async_register_subdev_sensor(&sc13xx->sd);
+	if (ret)
+		goto err_pm_disable;
+
+	return 0;
+
+err_pm_disable:
+	pm_runtime_disable(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+	v4l2_subdev_cleanup(&sc13xx->sd);
+
+err_entity_cleanup:
+	media_entity_cleanup(&sc13xx->sd.entity);
+
+err_power_off:
+	sc13xx_power_off(&client->dev);
+
+	return ret;
+}
+
+static void sc13xx_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct sc13xx *sc13xx = to_sc13xx(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev))
+		sc13xx_power_off(&client->dev);
+	pm_runtime_set_suspended(&client->dev);
+}
+
+static const struct dev_pm_ops sc13xx_pm_ops = {
+	SET_RUNTIME_PM_OPS(sc13xx_power_off, sc13xx_power_on, NULL)
+};
+
+static const struct of_device_id sc13xx_of_match[] = {
+	{ .compatible = "smartsens,sc1300cs", .data = &sc1300cs_cfg },
+	{ .compatible = "smartsens,sc820cs", .data = &sc820cs_cfg },
+	{ },
+};
+MODULE_DEVICE_TABLE(of, sc13xx_of_match);
+
+static struct i2c_driver sc13xx_i2c_driver = {
+	.driver = {
+		.name = "sc1300cs",
+		.of_match_table = sc13xx_of_match,
+		.pm = &sc13xx_pm_ops,
+	},
+	.probe = sc13xx_probe,
+	.remove = sc13xx_remove,
+};
+
+module_i2c_driver(sc13xx_i2c_driver);
+
+MODULE_DESCRIPTION("SmartSens SC1300CS/SC820CS camera sensor bring-up driver");
+MODULE_LICENSE("GPL");
