#!/bin/sh
# iceland deploy bootstrap initrd /init (busybox ash)
#
# The GPT initrd partition is a blob chain laid out by the build:
#     [u32 LE n0] bootstrap initrd   <-- the only part BootApp loads
#     [u32 LE n1] linux-modules deb
#     [u32 LE n2] linux-firmware-iceland deb
#     [u32 LE n3] linux-image deb
#     [u32 LE n4] linux-headers deb
# Keeping the debs out of the loaded initrd minimises bootloader memory
# use; at runtime this init walks the chain directly off the partition
# (disk -> tmpfs), then:
#   1. mounts the Ubuntu rootfs partition
#   2. chroot: resize2fs (grow into the partition), dpkg -i the debs
#      (their postinsts flash kernel/bootcfg/dtb/initrd partitions and
#      regenerate the Ubuntu initramfs)
#   3. /etc/deploy-mode selects the end game:
#        release: reboot into Ubuntu on success, stay on failure
#        debug:   never reboot -- usbnet + telnet stay up for inspection
# Failures keep the debug facilities alive in both modes.

BB=/bin/busybox
MODE=release
[ -f /etc/deploy-mode ] && MODE="$($BB cat /etc/deploy-mode 2>/dev/null)"
[ "$MODE" = debug ] || MODE=release

log() {
    echo "[deploy] $*" >/dev/console 2>&1 || echo "[deploy] $*" 2>/dev/null || true
    # failures must be visible in the on-rootfs log, not only on the console
    [ -n "${LOG:-}" ] && [ -f "${LOG}" ] && echo "[deploy] $*" >> "${LOG}" 2>/dev/null || true
}

# --- base filesystems --------------------------------------------------------
$BB mkdir -p /proc /sys /dev /dev/pts /tmp /run /etc /bin /sbin \
    /usr/bin /usr/sbin /lib /root /var/log
$BB grep -q ' /proc ' /proc/mounts 2>/dev/null || $BB mount -t proc proc /proc || log "mount /proc failed"
$BB grep -q ' /sys ' /proc/mounts 2>/dev/null || $BB mount -t sysfs sysfs /sys || log "mount /sys failed"
$BB grep -q ' /dev ' /proc/mounts 2>/dev/null || $BB mount -t devtmpfs devtmpfs /dev || log "mount /dev failed"
$BB mkdir -p /dev/pts   # devtmpfs shadows the cpio /dev, recreate it
$BB grep -q ' /dev/pts ' /proc/mounts 2>/dev/null || $BB mount -t devpts devpts /dev/pts || log "mount /dev/pts failed"
$BB mount -t tmpfs tmpfs /tmp 2>/dev/null || log "mount tmpfs /tmp failed (debs land in rootfs ram)"

if [ -c /dev/console ]; then
    exec 0</dev/console 1>/dev/console 2>&1 || true
fi

$BB --install -s || log "busybox --install failed"
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
hostname sm8850-deploy 2>/dev/null || true

# --- partition lookup (no udev: PARTNAME comes from the kernel uevent) ------
part_dev() {
    for u in /sys/class/block/*/uevent; do
        grep -q "^PARTNAME=$1\$" "$u" 2>/dev/null || continue
        d="$(sed -n 's/^DEVNAME=//p' "$u")"
        [ -n "$d" ] && { echo "/dev/$d"; return 0; }
    done
    return 1
}

# read the u32 LE blob header at byte offset $1 of device $2
read_u32() {
    off="$1"; dev="$2"
    dd if="$dev" bs=4096 skip=$((off / 4096)) count=2 2>/dev/null \
        | tail -c +$((off % 4096 + 1)) | head -c 4 \
        | od -An -tu4 | tr -d ' \n'
}

# --- usb gadget network first: debugging must work even if deploy fails -----
usbnet=ncm
for arg in $(cat /proc/cmdline 2>/dev/null); do
    case "$arg" in usbnet=*) usbnet="${arg#usbnet=}";; esac
done
case "$usbnet" in ncm|ecm|rndis) ;; *) usbnet=ncm ;; esac

mkdir -p /sys/kernel/config 2>/dev/null || true
grep -q ' /sys/kernel/config ' /proc/mounts 2>/dev/null || \
    mount -t configfs configfs /sys/kernel/config || log "mount configfs failed"

G=/sys/kernel/config/usb_gadget/g1
if mkdir -p "$G" 2>/dev/null; then
    echo 0x18d1 > "$G/idVendor" 2>/dev/null || true
    echo 0xd001 > "$G/idProduct" 2>/dev/null || true
    mkdir -p "$G/strings/0x409" "$G/functions/${usbnet}.usb0" "$G/configs/c.1"
    echo "Oneplus Pad 4 mainline" > "$G/strings/0x409/manufacturer" 2>/dev/null || true
    echo "sm8850 deploy"          > "$G/strings/0x409/product"      2>/dev/null || true
    echo "iceland-deploy"         > "$G/strings/0x409/serialnumber" 2>/dev/null || true
    ln -sf "$G/functions/${usbnet}.usb0" "$G/configs/c.1/${usbnet}.usb0" 2>/dev/null || true
    i=0
    while [ $i -lt 20 ]; do
        udc="$(ls /sys/class/udc 2>/dev/null | head -1)"
        [ -n "$udc" ] && break
        sleep 0.5; i=$((i + 1))
    done
    if [ -n "$udc" ]; then
        echo "$udc" > "$G/UDC" && log "gadget g1 bound to UDC $udc (${usbnet})" \
            || log "failed to bind UDC $udc"
    else
        log "no UDC found; usb network unavailable"
    fi
    i=0
    while [ $i -lt 20 ]; do
        [ -d /sys/class/net/usb0 ] && break
        sleep 0.5; i=$((i + 1))
    done
    ifconfig usb0 192.168.42.42 netmask 255.255.255.0 up 2>/dev/null \
        && log "usb0 up at 192.168.42.42/24" || log "ifconfig usb0 failed"
else
    log "cannot create usb_gadget/g1"
fi

touch /tmp/udhcpd.leases 2>/dev/null || true
if [ -f /etc/udhcpd.conf ]; then
    udhcpd /etc/udhcpd.conf && log "udhcpd started" || log "udhcpd failed"
fi
start_telnetd() { telnetd -p 23 -l /bin/sh 2>/dev/null && log "telnetd on :23" || true; }
start_telnetd

respawn_shell() {
    con="$1"
    i=0
    while [ $i -lt 10 ] && [ ! -c "$con" ]; do sleep 0.5; i=$((i + 1)); done
    [ -c "$con" ] || { log "console $con not available"; return; }
    log "shell on $con"
    while :; do
        setsid cttyhack /bin/sh < "$con" > "$con" 2>&1
        sleep 1
    done
}

# --- deploy steps; $1 = rootfs device ("" = already unmountable/not found) ----
# Success is reported via /tmp/deploy.status (the pipeline hides exit codes).
deploy_steps() {
    rdev="$1"
    echo fail > /tmp/deploy.status
    log "deploy mode: $MODE"

    idev="$(part_dev initrd)" || { log "ERROR: initrd partition not found"; return; }
    log "initrd partition: $idev"

    # walk the blob chain past our own initrd (blob 0)
    n0="$(read_u32 0 "$idev")"
    case "$n0" in ''|*[!0-9]*) log "ERROR: bad blob header on initrd partition"; return ;; esac
    cursor=$((4 + n0))
    mkdir -p /tmp/debs
    idx=0
    while :; do
        sz="$(read_u32 "$cursor" "$idev")"
        case "$sz" in ''|*[!0-9]*) break ;; esac
        [ "$sz" -gt 0 ] 2>/dev/null || break
        [ "$sz" -lt $((400 * 1024 * 1024)) ] 2>/dev/null || { log "ERROR: blob $idx size $sz insane"; return; }
        cursor=$((cursor + 4))
        blk=$((cursor / 4096)); into=$((cursor % 4096))
        nblk=$(((sz + into + 4095) / 4096))
        out="/tmp/debs/blob-$idx.deb"
        dd if="$idev" bs=4096 skip="$blk" count="$nblk" 2>/dev/null \
            | tail -c +$((into + 1)) | head -c "$sz" > "$out"
        got="$(stat -c %s "$out" 2>/dev/null || echo 0)"
        [ "$got" = "$sz" ] || { log "ERROR: blob $idx short read ($got/$sz)"; return; }
        log "blob $idx: $sz bytes -> $out"
        cursor=$((cursor + sz))
        idx=$((idx + 1))
    done

    # dpkg's initramfs trigger REFLASHES the initrd partition (that is what
    # boots the new system), destroying the container.  The install may
    # therefore only start once every deb is fully materialised in tmpfs
    # and validated: exact expected count + ar magic per blob.
    expected="$(cat /etc/deploy-blobcount 2>/dev/null || echo 4)"
    [ "$idx" = "$expected" ] \
        || { log "ERROR: read $idx debs from the partition, expected $expected"; return; }
    for f in /tmp/debs/blob-*.deb; do
        [ "$(head -c 8 "$f" 2>/dev/null)" = '!<arch>' ] \
            || { log "ERROR: $f is not a valid deb (ar magic missing)"; return; }
    done
    log "loaded $idx debs into tmpfs, all valid -- partition copy is now expendable"

    [ -n "$rdev" ] || { log "ERROR: rootfs not mounted"; return; }
    log "rootfs: $rdev at /rootfs"
    mkdir -p /rootfs/var/log /rootfs/root/kernel-debs

    # grow the filesystem into the partition before the debs land (best
    # effort: an already-maximum fs is not an error)
    mount -o bind /dev  /rootfs/dev  2>/dev/null || true
    mount -o bind /proc /rootfs/proc 2>/dev/null || true
    mount -o bind /sys  /rootfs/sys  2>/dev/null || true
    if chroot /rootfs resize2fs "$rdev" 2>&1; then
        log "resize2fs done"
    else
        log "WARNING: resize2fs nonzero (already grown?)"
    fi

    mount -o bind /tmp/debs /rootfs/root/kernel-debs || { log "ERROR: cannot stage debs"; return; }

    log "chroot: dpkg -i $(ls /tmp/debs | tr '\n' ' ')"
    if chroot /rootfs /usr/bin/env DEBIAN_FRONTEND=noninteractive \
            /bin/sh -c 'dpkg -i /root/kernel-debs/blob-*.deb' 2>&1; then
        log "dpkg install OK (kernel/bootcfg/dtb/initrd partitions updated)"
    else
        log "ERROR: dpkg install failed -- partitions may be half-updated"
        return
    fi
    echo ok > /tmp/deploy.status
}

# --- mount rootfs once, run the steps, log to console + rootfs ----------------
mkdir -p /rootfs
rdev="$(part_dev rootfs)"
LOG=/dev/null
if [ -n "$rdev" ] && mount -t ext4 -o rw "$rdev" /rootfs 2>/dev/null; then
    mkdir -p /rootfs/var/log
    LOG=/rootfs/var/log/kernel-deploy.log
    log "mounted $rdev at /rootfs (deploy log: /var/log/kernel-deploy.log)"
else
    rdev=""
    log "ERROR: cannot mount rootfs partition -- console log only"
fi

{ deploy_steps "$rdev"; } 2>&1 | tee "$LOG"
STATUS="$(cat /tmp/deploy.status 2>/dev/null || echo fail)"

if [ "$STATUS" = ok ]; then
    umount /rootfs/root/kernel-debs 2>/dev/null || true
    umount /rootfs/dev/pts 2>/dev/null || true
    umount /rootfs/dev /rootfs/proc /rootfs/sys 2>/dev/null || true
    umount /rootfs 2>/dev/null || umount -l /rootfs 2>/dev/null || true
fi

# --- end game ------------------------------------------------------------------
if [ "$STATUS" = ok ] && [ "$MODE" = release ]; then
    log "deploy OK (release) -- rebooting into Ubuntu"
    sync
    sleep 3
    reboot -f
    # reboot -f does not return; if it somehow does, fall through to debug
fi

if [ "$STATUS" = ok ]; then
    log "deploy OK ($MODE) -- staying up for inspection"
else
    log "deploy FAILED ($MODE) -- staying up for inspection"
fi
log "log: /rootfs/var/log/kernel-deploy.log   telnet: 192.168.42.42:23"
respawn_shell /dev/ttyMSM0 &
respawn_shell /dev/tty0 &

while :; do
    sleep 10
    pidof telnetd >/dev/null 2>&1 || start_telnetd
done
